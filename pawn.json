    "samp-incognito/samp-streamer-plugin:v2.9.6",
    "Y-Less/sscanf:v2.13.8",
    "oscar-broman/strlib#d48c74a65f03131381404fdc8e64873384e4c9b8",
    "YashasSamaga/SmartCMD#50fa082b62f613579588477ef4b5abb837e33f7c",
    "Southclaws/pawn-json:1.4.1",
    "Sreyas-Sreelal/samp-bcrypt:0.4.1",
    "JaTochNietDan/SA-MP-FileManager:1.5.1",
    "katursis/Pawn.RakNet:1.6.0-omp",
    "kristoisberg/pawn-colour-manipulation#be746e932b5a73a8bc4a25f7508dafdcacfa9e07",
