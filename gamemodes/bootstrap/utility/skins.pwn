stock bool:Util_IsValidSkin(skinid)
{
	return skinid >= 0 && skinid < 300 && skinid != 74;
}

stock Util_GetSkinGender(skinid)
{
	if (!Util_IsValidSkin(skinid))
	{
		return 0;
	}

	return s_SkinGender{skinid};
}
