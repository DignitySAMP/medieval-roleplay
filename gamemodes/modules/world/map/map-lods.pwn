static STREAMER_TAG_OBJECT:s_MapLodObjects[MAP_LOD_CHUNK_COUNT] = {STREAMER_TAG_OBJECT:INVALID_STREAMER_ID, ...};
static bool:s_MapLodReady[MAP_LOD_FIRST - MAP_LOD_LAST + 1];

stock Map_GetActiveLodCount()
{
    new count = 0;

    for (new i = 0; i < MAP_LOD_CHUNK_COUNT; i++)
    {
        if (IsValidDynamicObject(s_MapLodObjects[i]))
        {
            count++;
        }
    }

    return count;
}

stock Map_GetLodCount()
{
    return MAP_LOD_COUNT;
}

stock Map_GetLodDetail(index)
{
    return s_MapLods[index][0];
}

stock Map_GetLodChunkCount()
{
    return MAP_LOD_CHUNK_COUNT;
}

stock STREAMER_TAG_OBJECT:Map_GetLodChunkObject(chunk)
{
    return s_MapLodObjects[chunk];
}

stock Map_GetLodChunkMembers(chunk, members[], size = sizeof(members))
{
    new count = 0;

    for (new i = 0; i < MAP_LOD_COUNT && count < size; i++)
    {
        if (s_MapLods[i][1] == chunk)
        {
            members[count++] = s_MapLods[i][0];
        }
    }

    return count;
}

stock bool:Map_GetLodChunkHide(chunk, Float:points[], &Float:minz, &Float:maxz, size = sizeof(points))
{
    if (!s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_HIDES])
    {
        return false;
    }

    for (new i = 0; i < MAP_LOD_HIDE_POINTS * 2 && i < size; i++)
    {
        points[i] = s_MapLodHide[chunk][i];
    }

    minz = s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_MIN_Z];
    maxz = s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_MAX_Z];
    return true;
}

static Map_GetLodChunk(modelid)
{
    for (new i = 0; i < MAP_LOD_COUNT; i++)
    {
        if (s_MapLods[i][0] == modelid)
        {
            return s_MapLods[i][1];
        }
    }

    for (new i = 0; i < sizeof(s_MapLodVariants); i++)
    {
        if (s_MapLodVariants[i][0] == modelid || s_MapLodVariants[i][1] == modelid)
        {
            return s_MapLodVariants[i][2];
        }
    }

    for (new i = 0; i < MAP_LOD_CHUNK_COUNT; i++)
    {
        if (s_MapLodChunks[i][E_MAP_LOD_CHUNK_MODEL] == modelid)
        {
            return i;
        }
    }

    return -1;
}

stock Map_GetLodModel(modelid)
{
    for (new i = 0; i < MAP_LOD_COUNT; i++)
    {
        if (s_MapLods[i][0] == modelid)
        {
            return s_MapLodChunks[s_MapLods[i][1]][E_MAP_LOD_CHUNK_MODEL];
        }
    }

    for (new i = 0; i < sizeof(s_MapLodVariants); i++)
    {
        if (s_MapLodVariants[i][0] == modelid)
        {
            return s_MapLodVariants[i][1];
        }
    }

    return 0;
}

stock STREAMER_TAG_OBJECT:Map_GetLodObject(modelid)
{
    new chunk = Map_GetLodChunk(modelid);

    if (chunk == -1)
    {
        return STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    }

    return s_MapLodObjects[chunk];
}

static Map_AddLodModel(modelid, chunk, const txd[])
{
    if (modelid > MAP_LOD_FIRST || modelid < MAP_LOD_LAST || s_MapLodReady[MAP_LOD_FIRST - modelid])
    {
        return;
    }

    s_MapLodReady[MAP_LOD_FIRST - modelid] = true;
    Models_AddObject(modelid, s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_FILE], txd, s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_BASE]);
}

stock Map_RegisterLodVariant(modelid, const txd[])
{
    for (new i = 0; i < sizeof(s_MapLodVariants); i++)
    {
        if (s_MapLodVariants[i][0] == modelid)
        {
            Map_AddLodModel(s_MapLodVariants[i][1], s_MapLodVariants[i][2], txd);
            return;
        }
    }

    for (new i = 0; i < MAP_LOD_COUNT; i++)
    {
        if (s_MapLods[i][0] == modelid)
        {
            new chunk = s_MapLods[i][1];
            Map_AddLodModel(s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_MODEL], chunk, txd);
            return;
        }
    }
}

static Map_FitLodChunk(chunk, STREAMER_TAG_OBJECT:objectid)
{
    if (s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_HIDES])
    {
        new STREAMER_TAG_AREA:areaid = CreateDynamicPolygon(s_MapLodHide[chunk], s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_MIN_Z], s_MapLodChunks[chunk][E_MAP_LOD_CHUNK_MAX_Z], MAP_LOD_HIDE_POINTS * 2);
        Streamer_ToggleItemCallbacks(STREAMER_TYPE_AREA, areaid, false);
        Streamer_AppendArrayData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_AREA_ID, _:areaid);
        Streamer_ToggleItemInvAreas(STREAMER_TYPE_OBJECT, objectid, true);
    }

    Streamer_SetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_PRIORITY, MAP_LOD_PRIORITY);
}

stock Map_DestroyLodObject(STREAMER_TAG_OBJECT:objectid)
{
    for (new i = 0; i < MAP_LOD_CHUNK_COUNT; i++)
    {
        if (s_MapLodObjects[i] == objectid)
        {
            s_MapLodObjects[i] = STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
        }
    }

    if (IsValidDynamicObject(objectid))
    {
        new areas[4], count = min(Streamer_GetArrayDataLength(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_AREA_ID), sizeof(areas));

        if (count > 0)
        {
            Streamer_GetArrayData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_AREA_ID, areas, count);
        }

        DestroyDynamicObject(objectid);

        for (new i = 0; i < count; i++)
        {
            if (IsValidDynamicArea(STREAMER_TAG_AREA:areas[i]))
            {
                DestroyDynamicArea(STREAMER_TAG_AREA:areas[i]);
            }
        }
    }
}

stock Map_SetLodModel(original, target)
{
    new STREAMER_TAG_OBJECT:objectid = Map_GetLodObject(original), modelid = Map_GetLodModel(target);

    if (IsValidDynamicObject(objectid) && modelid != 0 && Streamer_GetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_MODEL_ID) != modelid)
    {
        Streamer_SetIntData(STREAMER_TYPE_OBJECT, objectid, E_STREAMER_MODEL_ID, modelid);
        new Float:x, Float:y, Float:z;
        GetDynamicObjectPos(objectid, x, y, z);
        Nearby_QueueStream(STREAMER_TYPE_OBJECT, x, y, z, -1, -1, -1, MAP_LOD_DISTANCE);
    }
}

stock STREAMER_TAG_OBJECT:Map_CreateLod(modelid, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz)
{
    new lod = Map_GetLodModel(modelid), chunk = Map_GetLodChunk(modelid);

    if (lod == 0 || chunk == -1)
    {
        return STREAMER_TAG_OBJECT:INVALID_STREAMER_ID;
    }

    new STREAMER_TAG_OBJECT:objectid = Nearby_CreateDynamicObject(lod, x, y, z, rx, ry, rz, -1, -1, -1, MAP_LOD_DISTANCE, MAP_LOD_DISTANCE, STREAMER_TAG_AREA:-1, MAP_STREAM_PRIORITY);
    s_MapLodObjects[chunk] = objectid;
    Map_FitLodChunk(chunk, objectid);
    return objectid;
}

Map_FitLods()
{
    for (new i = 0; i < MAP_LOD_CHUNK_COUNT; i++)
    {
        new STREAMER_TAG_OBJECT:objectid = s_MapLodObjects[i];

        if (IsValidDynamicObject(objectid))
        {
            Map_FitLodChunk(i, objectid);
        }
    }
}

stock Map_LoadLods()
{
    for (new i = 0; i < MAP_LOD_CHUNK_COUNT; i++)
    {
        if (!s_MapLodChunks[i][E_MAP_LOD_CHUNK_BOOT])
        {
            continue;
        }

        Map_AddLodModel(s_MapLodChunks[i][E_MAP_LOD_CHUNK_MODEL], i, s_MapLodChunks[i][E_MAP_LOD_CHUNK_TXD]);
        s_MapLodObjects[i] = Nearby_CreateDynamicObject(s_MapLodChunks[i][E_MAP_LOD_CHUNK_MODEL], s_MapLodChunks[i][E_MAP_LOD_CHUNK_X], s_MapLodChunks[i][E_MAP_LOD_CHUNK_Y], s_MapLodChunks[i][E_MAP_LOD_CHUNK_Z], 0.0, 0.0, 0.0, -1, -1, -1, MAP_LOD_DISTANCE, MAP_LOD_DISTANCE, STREAMER_TAG_AREA:-1, MAP_STREAM_PRIORITY);
    }
}
