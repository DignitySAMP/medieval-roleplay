stock bool:Map_GetRadarStructure(index,&Float:minX,&Float:minY,&Float:maxX,&Float:maxY,&bool:isFortified)
{
	if (index < 0 || index >= MAP_RADAR_STRUCTURE_COUNT)
	{
		return false;
	}

	minX = s_MapRadarStructures[index][E_MAP_RADAR_STRUCTURE_MIN_X];
	minY = s_MapRadarStructures[index][E_MAP_RADAR_STRUCTURE_MIN_Y];
	maxX = s_MapRadarStructures[index][E_MAP_RADAR_STRUCTURE_MAX_X];
	maxY = s_MapRadarStructures[index][E_MAP_RADAR_STRUCTURE_MAX_Y];
	isFortified = s_MapRadarStructures[index][E_MAP_RADAR_STRUCTURE_FORTIFIED];
	return true;
}
