static s_TutorialPalisadeIds[TUTORIAL_PALISADE_OBJECTS];

TutorialPalisade_Create()
{
	for (new i = 0;i < TUTORIAL_PALISADE_PIECES;i++)
	{
		new model = s_TutorialPalisadePieces[i][E_TUTORIAL_PALISADE_MODEL], Float:x = s_TutorialPalisadePieces[i][E_TUTORIAL_PALISADE_POSE][0], Float:y = s_TutorialPalisadePieces[i][E_TUTORIAL_PALISADE_POSE][1], Float:z = s_TutorialPalisadePieces[i][E_TUTORIAL_PALISADE_POSE][2], Float:rx = s_TutorialPalisadePieces[i][E_TUTORIAL_PALISADE_POSE][3], Float:ry = s_TutorialPalisadePieces[i][E_TUTORIAL_PALISADE_POSE][4], Float:rz = s_TutorialPalisadePieces[i][E_TUTORIAL_PALISADE_POSE][5];
		new STREAMER_TAG_OBJECT:piece = CreateDynamicObject(model,x,y,z,rx,ry,rz,-1,-1,-1,TUTORIAL_PALISADE_STREAM,TUTORIAL_PALISADE_DRAW);

		switch (model)
		{
			case TUTORIAL_PALISADE_STAKE:
			{
				SetDynamicObjectMaterial(piece,1,19297,"matlights","invisible",0);
			}
			case TUTORIAL_PALISADE_TIP:
			{
				SetDynamicObjectMaterial(piece,0,18259,"logcabincs_t","Gen_Log_End",0);
			}
			case TUTORIAL_PALISADE_WALL:
			{
				SetDynamicObjectMaterial(piece,0,18259,"logcabincs_t","Gen_Log",TUTORIAL_PALISADE_WALL_SHADE);
			}
		}

		CA_CreateObject(model,x,y,z,rx,ry,rz,true);
		s_TutorialPalisadeIds[i] = _:piece;
	}

	for (new i = 0;i < TUTORIAL_MUD_ROADS;i++)
	{
		new model = s_TutorialMudRoads[i][E_TUTORIAL_MUD_MODEL], Float:x = s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][0], Float:y = s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][1], Float:z = s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][2], Float:rz = s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][3];
		new STREAMER_TAG_OBJECT:road = CreateDynamicObject(model,x,y,z,0.0,0.0,rz,-1,-1,-1,TUTORIAL_PALISADE_STREAM,TUTORIAL_PALISADE_DRAW);

		for (new material = 0;material < s_TutorialMudRoads[i][E_TUTORIAL_MUD_MATERIALS];material++)
		{
			SetDynamicObjectMaterial(road,material,TUTORIAL_MUD_TXD_MODEL,TUTORIAL_MUD_TXD,TUTORIAL_MUD_TEXTURE,0);
		}

		CA_CreateObject(model,x,y,z,0.0,0.0,rz,true);
		s_TutorialPalisadeIds[TUTORIAL_PALISADE_PIECES + 1 + i] = _:road;
	}

	s_TutorialPalisadeIds[TUTORIAL_PALISADE_PIECES] = _:CreateDynamicObject(TUTORIAL_MODEL_BOUNDS,TUTORIAL_BOUNDS_X,TUTORIAL_BOUNDS_Y,TUTORIAL_BOUNDS_Z,0.0,0.0,0.0,-1,-1,-1,TUTORIAL_PALISADE_STREAM,TUTORIAL_PALISADE_DRAW);

	if (CA_LoadFromDff(TUTORIAL_MODEL_BOUNDS,TUTORIAL_BOUNDS_DFF) == 1)
	{
		CA_CreateObject(TUTORIAL_MODEL_BOUNDS,TUTORIAL_BOUNDS_X,TUTORIAL_BOUNDS_Y,TUTORIAL_BOUNDS_Z,0.0,0.0,0.0,true);
	}
	else
	{
		Log_Warn("tutorial","no collision for the island's boundary %d (%s)",TUTORIAL_MODEL_BOUNDS,TUTORIAL_BOUNDS_DFF);
	}

	Log_Info("tutorial","the palisade stands: %d pieces, and the island is walled in",TUTORIAL_PALISADE_PIECES);
}

stock TutorialPalisade_GetObject(index)
{
	if (index < 0 || index >= TUTORIAL_PALISADE_OBJECTS)
	{
		return INVALID_STREAMER_ID;
	}

	return s_TutorialPalisadeIds[index];
}

#include <pp-hooks>

hook Models_OnRegister()
{
	Models_AddObject(TUTORIAL_MODEL_BOUNDS,TUTORIAL_BOUNDS_DFF,TUTORIAL_BOUNDS_TXD);

	for (new i = 0;i < TUTORIAL_MUD_ROADS;i++)
	{
		CA_RemoveBuilding(s_TutorialMudRoads[i][E_TUTORIAL_MUD_MODEL],s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][0],s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][1],s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][2],1.0);
	}
}

hook OnPlayerConnect(playerid)
{
	for (new i = 0;i < TUTORIAL_MUD_ROADS;i++)
	{
		new Float:x = s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][0], Float:y = s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][1], Float:z = s_TutorialMudRoads[i][E_TUTORIAL_MUD_POSE][2];
		RemoveBuildingForPlayer(playerid,s_TutorialMudRoads[i][E_TUTORIAL_MUD_MODEL],x,y,z,1.0);

		if (s_TutorialMudRoads[i][E_TUTORIAL_MUD_LOD] != -1)
		{
			RemoveBuildingForPlayer(playerid,s_TutorialMudRoads[i][E_TUTORIAL_MUD_LOD],x,y,z,1.0);
		}
	}
}
