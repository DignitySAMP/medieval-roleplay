stock Faith_FindText(const key[])
{
	for (new i = 0;i < FAITH_TEXT_COUNT;i++)
	{
		if (!strcmp(s_FaithTexts[i][E_FAITH_TEXT_KEY],key))
		{
			return i;
		}
	}

	return -1;
}

stock bool:Faith_GetTextInfo(text,&kind,&season,&count,&bool:isBilingual)
{
	if (text < 0 || text >= FAITH_TEXT_COUNT)
	{
		return false;
	}

	kind = s_FaithTexts[text][E_FAITH_TEXT_KIND];
	season = s_FaithTexts[text][E_FAITH_TEXT_SEASON];
	count = s_FaithTexts[text][E_FAITH_TEXT_COUNT];
	isBilingual = s_FaithTexts[text][E_FAITH_TEXT_BILINGUAL];
	return true;
}

stock Faith_GetTextLine(text,line,dest[],size = sizeof(dest))
{
	dest[0] = EOS;

	if (text < 0 || text >= FAITH_TEXT_COUNT || line < 0 || line >= s_FaithTexts[text][E_FAITH_TEXT_COUNT])
	{
		return;
	}

	strunpack(dest,s_FaithLines[s_FaithTexts[text][E_FAITH_TEXT_FIRST] + line],size);
}
