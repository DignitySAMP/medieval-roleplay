	Models_AddObject(MODEL_ICONS_GEAR,"ui/sprite_model.dff","ui/icons_gear.txd");
	Models_AddObject(MODEL_ICONS_ARMS,"ui/sprite_model.dff","ui/icons_arms.txd");
}
