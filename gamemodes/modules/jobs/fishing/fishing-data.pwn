enum
{
	FISHING_WATER_NONE,
	FISHING_WATER_RIVER,
	FISHING_WATER_POND,
	FISHING_WATER_LAKE,
	FISHING_WATER_SEA,
	FISHING_WATER_COUNT,
}

enum E_FISHING_WATER_CELL
{
	Float:E_FISHING_WATER_X,
	Float:E_FISHING_WATER_Y,
	Float:E_FISHING_WATER_Z,
	E_FISHING_WATER_TYPE,
	E_FISHING_WATER_BODY,
}

static const s_FishingWaterNames[FISHING_WATER_COUNT][FISHING_WATER_NAME_LEN] = {
	"", "river", "pond", "lake", "sea"
};

stock Fishing_GetWaterName(type,dest[],size = sizeof(dest))
{
	dest[0] = EOS;

	if (type > FISHING_WATER_NONE && type < FISHING_WATER_COUNT)
	{
		strcopy(dest,s_FishingWaterNames[type],size);
	}
}

