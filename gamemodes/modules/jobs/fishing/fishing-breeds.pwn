#define FISH_SEASON_AUTUMN (1 << _:SEASON_AUTUMN)
#define FISH_SEASONS_ALL (FISH_SEASON_WINTER | FISH_SEASON_SPRING | FISH_SEASON_SUMMER | FISH_SEASON_AUTUMN)
