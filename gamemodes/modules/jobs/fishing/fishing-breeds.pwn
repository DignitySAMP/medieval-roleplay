stock Fishing_GetBreedCount()
{
	return sizeof(g_FishBreeds);
}

stock Fishing_FindBreed(item)
{
	for (new i = 0;i < sizeof(g_FishBreeds);i++)
	{
		if (g_FishBreeds[i][E_FISH_BREED_ITEM] == item)
		{
			return i;
		}
	}

	return -1;
}

stock bool:Fishing_IsRodBreed(breed)
{
	return breed >= 0 && breed < sizeof(g_FishBreeds) && g_FishBreeds[breed][E_FISH_BREED_BAIT] != 0;
}

stock Fishing_GetBaitBit(item)
{
	switch (item)
	{
		case ITEM_WORMS: return FISH_BAIT_WORMS;
		case ITEM_BREAD: return FISH_BAIT_BREAD;
		case ITEM_GRUBS: return FISH_BAIT_GRUBS;
		case ITEM_MAGGOTS: return FISH_BAIT_MAGGOTS;
		case ITEM_MEAT_BEEF, ITEM_MEAT_PORK, ITEM_MEAT_MUTTON, ITEM_MEAT_VENISON, ITEM_MEAT_BOAR: return FISH_BAIT_MEAT;
	}

	new breed = Fishing_FindBreed(item);
	return breed != -1 && g_FishBreeds[breed][E_FISH_BREED_SMALL] ? FISH_BAIT_SMALL_FISH : 0;
}

stock Fishing_RegisterItems()
{
	new const bait[] = {ITEM_WORMS, ITEM_BREAD, ITEM_GRUBS, ITEM_MAGGOTS, ITEM_MEAT_BEEF, ITEM_MEAT_PORK, ITEM_MEAT_MUTTON, ITEM_MEAT_VENISON, ITEM_MEAT_BOAR};

	for (new i = 0;i < sizeof(bait);i++)
	{
		Item_AddToGroup(ITEM_BAIT,bait[i]);
	}

	Item_AddToGroup(ITEM_FISH,ITEM_FISH_RARE);

	for (new i = 0;i < sizeof(g_FishBreeds);i++)
	{
		new item = g_FishBreeds[i][E_FISH_BREED_ITEM];
		Item_AddToGroup(ITEM_FISH,item);
		Item_SetPerishable(item,ITEM_FISH_FRESH_SECONDS,ITEM_SPOILED_FISH);

		if (g_FishBreeds[i][E_FISH_BREED_SMALL])
		{
			Item_AddToGroup(ITEM_BAIT,item);
		}
	}
}
