static const s_FamilyTalkAnswers[FAMILY_SEED_HOUSEHOLDS][3][144] = {
    {
        "Jakub and Dorota live here with their three children and Ludmila, their grandmother.",
        "We work the rye fields. The low strip has had too much rain.",
        "The rye is coming up thin this {season}. We're worried there won't be enough for the house."
    },
    {
        "Pavel, Agnes and their daughter Johanka share this house.",
        "Pavel and Agnes weave cloth for the merchants.",
        "A merchant wants blue cloth before {season} ends. Finding enough blue dye is the trouble."
    },
    {
        "Mikulas and Hedvika live here with Ota and Marketa, their children.",
        "Mikulas is a clerk. His writing buys our bread.",
        "The rolls have to be ready before {season} ends. There's still writing to do."
    },
    {
        "Stepan and Klara keep this house. Kuba, the baker's apprentice, lives here too.",
        "Bread is our living. The oven has us up before Prime.",
        "There's bread to bake again tomorrow. A warm loaf helps on an early morning."
    },
    {
        "Radek lives here with his sons Lukas and Vit.",
        "Radek works timber for houses and scaffolds.",
        "The mason needs scaffold poles before {season} ends. Buying timber from the woodcutter will cost us dearly."
    },
    {
        "Bohus and Zuzana keep the inn with their children Eliska and Tomas.",
        "The inn gives travellers food and a bed.",
        "Two travellers left without paying last night. We have to swallow that coin ourselves."
    },
    {
        "Zdenek and his son Petr live here.",
        "We make pots for a living.",
        "We hope the pots sell well enough to carry us through {season}."
    },
    {
        "Ondrej and Magda live here with their son Jindrich and daughter Veronika.",
        "We tend the herd.",
        "One of our beasts needs warm mash again. We had the same worry last {season}."
    },
    {
        "Vaclav and Anna share this house.",
        "The orchard and the bees keep us.",
        "The bees have swarmed three times this {season}. It's a bad year for the hives."
    },
    {
        "Dietrich and Katerina live here with Ulrich, the journeyman.",
        "Laying stone is how we earn our bread.",
        "There's a crack in the castle wall wide enough for a fist. It worries the masons in our house."
    },
    {
        "Jan and Hanzl share this house by the woods.",
        "Jan tends the forest. Hanzl burns charcoal.",
        "There are big boar tracks by the south clearing. Nobody from our house wants to meet that beast at dusk."
    },
    {
        "Matous and Lida live here.",
        "Matous and Lida make and mend clothes.",
        "The reeve's clerk wants a black lined coat by Sunday. That's a lot of sewing."
    },
    {
        "Konrad and Gertruda live here with Albrecht and Elsa, their children.",
        "We trade goods at the fairs.",
        "Albrecht wants to take the cart to the fair this {season}. He's keen to join the trade."
    },
    {
        "Bartolomej and his son Martin share this house.",
        "Martin makes barrels. His father Bartolomej lives with him.",
        "Bartolomej's cough is worse this {season}. We may have to fetch the herb widow."
    },
    {
        "Jiri and Bozena live here with Hana and Jana, their twin daughters.",
        "We brew ale for the inn.",
        "The innkeeper says our ale is sour. We've been arguing about the last brew."
    },
    {
        "Vojtech and Marie live here with Hynek, the smith's apprentice.",
        "We work at the forge.",
        "Charcoal is short this {season}. The burner doesn't bring what the forge needs."
    },
    {
        "Prokop and Ruzena live here with Adam and Ida, their children.",
        "We work a strip of turnips and keep a goat.",
        "Food is thin this {season}. The turnips have to feed us as well as the goat."
    },
    {
        "Vendula and Alzbeta are sisters. They share this house.",
        "We dye cloth with woad.",
        "Our woad has been coming out green. The weavers asking for blue won't buy it."
    },
    {
        "Benes and Bohdana live here with Kristof, the bowyer.",
        "Wheels for carts and bows are what we make.",
        "Our steam trough has cracked. A week without work will hurt."
    },
    {
        "Svatava and her son Bohumil live here.",
        "Svatava bakes loaves for the village.",
        "People keep bargaining down the price of our bread. The flour still has to be paid for."
    },
    {
        "Radmila lives here alone. Her husband has been in the churchyard for thirty years.",
        "This house belongs to a healer. Radmila knows herbs for fevers and broken bones.",
        "Radmila needs yarrow from the roadsides this {season}. She uses it to stop bleeding."
    },
    {
        "Emil and Berta live here with Rozalie and Viktor, their children.",
        "Candles are our trade. We make them from tallow.",
        "The church wants two hundred candles for the feast. That's a lot of work for us."
    },
    {
        "Otakar and Milada keep this house and the Hare alehouse.",
        "The Hare pours ale for the village.",
        "The bowyer has been drinking on credit for three weeks. Our kegs are low. We need coin for more ale."
    },
    {
        "Kilian and Johana live here with Benedikt and Krystyna, their children.",
        "We live by fishing. Fast days bring buyers for the catch.",
        "Someone's been taking fish from our traps upstream. That was our own food."
    },
    {
        "Havel and Sabina share this house.",
        "We thatch roofs for a living.",
        "Our own roof drips on the bed. The flooded reed bed makes finding good thatch harder."
    },
    {
        "Lambert and Frantiska live here with Rupert, Liba and Silvestr, the journeyman.",
        "We butcher animals and make sausages.",
        "We have three pigs to slaughter before {season} ends. Salt has grown dear again."
    },
    {
        "Gabriel and his son Damian live here. Damian's mother has passed away.",
        "Tanning is our trade. Hides go in and leather comes out.",
        "Our bark tubs are nearly empty. We'll need more oak bark to keep tanning."
    },
    {
        "Erazim and Dobromila live here with their daughter Mlada.",
        "We keep bees for honey and wax.",
        "Our mead is ready. Erazim reckons it's the best our house has made in three years."
    },
    {
        "Blazej and Apolena live here with Kaspar, their eldest.",
        "Field work for the yeoman is how we get by.",
        "The count's men took our goose for the tax. There's little enough left for the table."
    },
    {
        "Simon and Tereza live here with Dalibor and Nela, their children.",
        "Our family keeps sheep. The weaver in Talmberg wants to buy our fleeces.",
        "Wolves took two of our lambs on the high pasture. We're worried about the rest of the flock."
    },
    {
        "Robert and Irena share this house.",
        "Hunting and selling pelts keeps us.",
        "Our fox pelt fetched less than we'd hoped. That leaves less coin for the house this {season}."
    },
    {
        "Valentin and Monika live here with Dusan, Pavla and their grandfather Matyas.",
        "The iron mine feeds us. Matyas worked below ground for fifty years.",
        "The new seam has good iron, but the shaft groans at night. We're afraid for those working below."
    },
    {
        "Augustin and Kunhuta live here. Their sons are buried in the churchyard.",
        "We keep hens. They've started laying again.",
        "We had two eggs this morning. That's welcome food for our small house."
    },
    {
        "Arnost and Vilma live here with Blanka, Leopold and Lojza, the mill hand.",
        "The mill grinds grain for the farmers.",
        "The mill sail is torn again. It needs mending before the harvest comes in."
    },
    {
        "Dominik and Barbora live here with their children, Vlasta and two farmhands.",
        "Our family farms land that Dominik's grandfather bought with silver.",
        "This farm has been ours since grandfather's day. We're glad of land of our own."
    },
    {
        "Benedikt and Marta share this house.",
        "We work for the abbey, which feeds us.",
        "Brother Hugh needs the herb garden weeded before the frost. That job's ours."
    },
    {
        "Kasimir and Kordula live here.",
        "Kasimir is a barber-surgeon. That pays for our bread.",
        "Kasimir set a leg and pulled a tooth today. It's been a good day for coin."
    },
    {
        "Bernard and Adelheid live here with Fridrich and Wenzel, the journeymen.",
        "We make armour.",
        "There's a long night of rivet making ahead. Last {season}, Bernard fell asleep at the bench."
    },
    {
        "Jeronym and his manservant Bertold share this house.",
        "Jeronym earns his bread as a scribe. Bertold keeps the house.",
        "We've had little company at our table since {season} began. A visitor is welcome here."
    },
    {
        "Gotthard and Rosina live here with Adela and Lambert, their children.",
        "We tend the duke's hunting hounds.",
        "The duke hunts on Thursday. We're checking that every hound is fit."
    },
    {
        "Walter lives here with his mother Notburga and Fricek, the stable boy.",
        "Walter keeps a stopping place for travellers through the pass.",
        "The pass is cold this {season}. Travellers can warm themselves at our hearth."
    }
};

static const s_FamilyTopicAnswers[FAMILY_SEED_TOPICS][128] = {
    "The low strip stayed wet after the rain. Rye rots in wet ground.",
    "That pot is the last of the barley until market. I won't pretend there's a second helping.",
    "I remember fuller barns and a cow that gave milk all through the cold months. We ate better then.",
    "Mother thinks I broke the jug, but Bara knocked it off the shelf. I only picked up the pieces.",
    "Long nights bring cold and wolves. A prayer before sleep keeps the house calm.",
    "A merchant ordered a bolt of blue and I've no dye for it. Good blue is rare and dear around here.",
    "The reeve wants the tax rolls written out before {season} ends. I've still got pages to copy.",
    "Bread has to be in the ovens long before dawn. Late loaves go cold and nobody buys them.",
    "The mason wants poles that won't snap under a man. We have to find the timber first.",
    "Good poles come from the woodcutter and he knows we've no choice. He'll name his price and we'll pay it.",
    "Two men ate, drank and slept, then slipped out before dawn. That's a night's coin and a bed, gone.",
    "If the pots sell at market, we'll have coin put by for once. Most years we just scrape through.",
    "Her belly is hard and she won't eat. Warm mash eased her last time. Worth another try.",
    "When a swarm leaves, the honey goes with it. That's three times now, and I'm losing hives.",
    "I walked the wall at dawn and saw it myself. A crack that size will let the damp in and bring stones down.",
    "Boars gore anyone who corners them, and dusk is when they feed. I don't want anyone coming home torn.",
    "The clerk wants to look important when the reeve visits. I've the cloth for it and little time.",
    "I'm old enough to bargain and I've watched you do it. Let me prove I can sell as well as buy.",
    "It's a dry hacking cough that hasn't eased in weeks. The herb widow knows more than I do.",
    "The innkeeper wants a lower price, so he calls our ale sour. I tasted the last brew myself and it was fine.",
    "The forge eats charcoal and the burner brings half of what we need. He naps while his piles smoulder.",
    "Five of us to feed and the garden gave us only turnips this year. It worries me.",
    "God gives us the strength to work but he won't weed the turnips. I'd rather you pulled weeds than prayed at the wall.",
    "We've given the goat the scraps that we should have kept for us. I'm only saying how it looks.",
    "She had two candles spare and gave them to us unasked. Kindness like that deserves a prayer in return.",
    "The patch above our bench lets the rain in and the wood is wet. I'm tired of sitting in it.",
    "Enough talk. It's late and the little ones are hungry. We eat what's put in front of us and say thanks.",
    "I steeped the woad too long, or something in the water spoiled it. The colour should have been a deep blue.",
    "She asked me for a soft green and I'd rather say yes. A baby needs a blanket and she's asking nicely.",
    "If she wants green, she can pay what green costs. I won't give away work that took me a week.",
    "He's a weaver and needs blue cloth for his trade. His daughter wears the old kind and he wants better for her.",
    "If he wants blue, he should come and say so to my face. I send nothing out on rumour.",
    "Two sisters alone can't keep a dye house forever. We need husbands before we're too old to find them.",
    "A wheel takes a lot of oak and work. The harvest was thin, so folk put off the repair as long as they can.",
    "He wants a bow that drops a deer at sixty paces. That takes yew, and yew is scarce in these hills.",
    "A cracked trough won't hold steam, and without steam I can't bend staves. Every job in the shop stops.",
    "She keeps looking over whenever you're nearby. I thought you might want to hear it from me.",
    "They all haggle over a loaf as if I were robbing them. My oven burns costly wood and I want some respect.",
    "A man who owes you on Monday never remembers it on Friday. Pay first or no bread. That's how I've kept this oven.",
    "The crofter's house is already crowded and money is tight. I fear for the mother. She isn't strong.",
    "I've used them for thirty years and they work. When herbs aren't enough, I can only pray.",
    "He draws blood for every complaint. The poor are left weak and some never recover.",
    "You're a guest, so you eat first. My table is plain but it's clean, and nobody leaves it hungry.",
    "He was the one who laid the stones and set the beams. I still keep his chair by the hearth.",
    "It stops a wound from bleeding and it grows by roadsides when the weather is warm. It would be a great help to me.",
    "The feast of the patron saint is coming and the whole parish will burn candles. I've never had such an order.",
    "The church pays in blessings and a few coins. The crofter's turnips at least feed us.",
    "Tallow smells of fat and smoke, and it gets into the bread, the bed and our clothes. I'm tired of it.",
    "A man who can't read has no business telling me what a candle costs. Let him learn to count first.",
    "It's the better ale and the better welcome. People travel from other villages just for a cup.",
    "My husband says it because it's true. We're the only alehouse here, so he doesn't have to boast.",
    "He keeps drinking and signing his name in chalk. I can't carry that debt much longer.",
    "Bow makers get paid when the lords call for bows. Sooner or later he'll settle up with us.",
    "We're running out of ale and the brewer in Talmberg sells the best barrels. Someone has to go and ask him.",
    "The first cup is a welcome and that's our custom. After that the barrel is for paying customers.",
    "Eels move downstream at this time of year. If we set the traps tonight, we catch the first run.",
    "We eat fish at every meal and I'm tired of the smell. A good sausage would be a feast to me.",
    "When the church calls a fast day, everyone buys fish at once and the price rises. We're the ones who catch it.",
    "I reached into the cold water and grabbed it with my own two hands. I was so proud of it.",
    "I saw that trout. It was no longer than my hand, whatever he says.",
    "Somebody has been lifting the fish out of my traps upstream. A man has a right to be angry about it.",
    "We don't fight over fish. The guards can settle it and nobody gets hurt.",
    "They eat my catch and never pay, so what good are they to me? I do all the work.",
    "A storm lifted half the thatch in the hamlet. I can only do one roof at a time.",
    "Water drips on our bed every night and I'm tired of being wet. Charity begins at home.",
    "It's an old joke among thatchers. We're so busy mending others' roofs that we have no time for our own.",
    "The river rose over the bed and ruined this year's reeds. We'll struggle to find enough to cover a roof.",
    "Straw is cheaper but it rots after a couple of winters. Then we must start all over again.",
    "Let's give thanks before the roof drips on our food. It's the one thing that can't wait.",
    "The frost is coming and the meat needs to be done by then. Salt has become dearer, which makes it harder.",
    "Smoke keeps meat just as well and costs nothing but wood. It's all we can afford this year.",
    "He offered a good eel but we need salt and wood, not fish. A fisherman can find a better trade than that.",
    "Anything that keeps through the cold months is worth having. I'll swallow my pride for a full larder.",
    "His pens were wrecked and he can't deal with a boar on his own. He hoped we'd take it off his hands.",
    "We won't go hunting a boar ourselves. A butcher needs a dead animal brought to him first.",
    "It's still soft in the middle and needs more time in the pot. I know it isn't ready, mother.",
    "It tastes fine either way. I won't waste good food, so you will eat it as it comes.",
    "People turn up their noses at the smell of tanning, but they all wear leather. Their boots come from this work.",
    "He said the stink bothers the others at mass. It's unfair, because we pay our tithe like everybody else.",
    "Prayer carries over the smell. Our place at the back is no worse, and God hears us wherever we kneel.",
    "Oak bark is what makes the leather. Without bark, we can't tan a single hide.",
    "We can't tan without bark and the best oak is in the woods. It's hard work.",
    "She never complained and I won't forget it. She knew the smell was how we earned our bread.",
    "I've tasted it and it's sweet and clear. It's the finest I've made in a long time.",
    "You were proud of the last one too. I'm only saying that you say it every time.",
    "It was true then and it's true now. Every batch teaches me something and the mead keeps improving.",
    "It swelled up and I could hardly see out of it. I only went to look at the bees.",
    "Stay back from the hive when they're angry. The bees don't like it when you stand close.",
    "The church always needs wax, and they'll buy all we have. The chandler's cousin knows who to ask.",
    "If they take all our wax, we'll want something in return. Honey is what we have to trade.",
    "They're made with our own honey and a little flour. Nothing else in this hamlet tastes that sweet.",
    "He paid in rye mixed with chaff because he's short himself. It was that or nothing, and we needed it.",
    "We have bread on the table and many don't. I'd like you to remember that when you grumble.",
    "The bowl was small and I'm still growing. There's never enough to go around.",
    "We were all hungry long before supper. Don't think you're alone. You're just the loudest about it.",
    "The tax collectors came for the goose and we couldn't argue. That bird was meant for our winter table.",
    "Her cough has kept us awake all week and the little ones have caught it. I don't know what to do.",
    "We're poor, and I won't pretend otherwise. But there's a fire here and nobody will leave cold.",
    "Wolves came down from the hills at night. Two lambs gone is a hard loss for a small flock.",
    "A dog barks and keeps them off. Our flock is small and one man can't watch it all night.",
    "He's a good dog but he's a coward and runs at the first howl. I wouldn't trust him with the flock.",
    "I want to help protect the sheep. I practise with my sling every day and I've got good aim.",
    "You're too young to chase wolves. I won't see you hurt, so you stay behind the fold.",
    "Wool is what we live on and the weaver always needs more. He sent word and wants all we can spare.",
    "He should pay a fair price for good wool. We've worked all year for those fleeces.",
    "The tracks were fresh and as wide as my hand. A boar that big would feed us for months.",
    "The wood belongs to the count, and the forester has no mercy for poachers. I'd rather you stayed out of trouble.",
    "The forester claims the whole forest and I've never seen him leave a corner of it. A hunter must go where the game is.",
    "The fur was thin and the buyer knew it. He paid less than we hoped, and we'd counted on that coin.",
    "It's venison and it's good. Where it came from is nobody's business.",
    "The new vein has good ore but the timbers creak all night. I'm afraid it isn't safe down there.",
    "The shaft groans when the timbers shift. Better nobody is down there in the dark hours.",
    "I worked in the dark for fifty years and my chest is ruined by the dust. Don't follow me into it.",
    "I'm old enough to carry the lamp and I'm proud that he trusts me. I'll hold it steady.",
    "I'll wait at the shaft every evening. If you don't come up, I'll go down and fetch you.",
    "It's an old story from before the shaft collapsed. I like how the lamps flicker when he tells it.",
    "I'm tired and my bones ache. Each year the cold gets into them deeper and the mornings are harder.",
    "They lay better when the days get longer. Eggs are rare in winter, so two is a good morning.",
    "She's kind, and she thinks of us when she has milk to spare. It means a lot when you have so little.",
    "We lost our sons and visit them in the churchyard. It's lonely here, so forgive us if we chatter.",
    "He says this every harvest and I'm used to it. A baker finds fault with whatever he doesn't make himself.",
    "The millstones wear smooth and must be chiselled to grip the grain. I've put it off too long, and it's my own fault.",
    "The wind caught it and tore a corner. A miller with a torn sail grinds nothing.",
    "The harvest will bring in plenty of grain. I need the mill ready or the farmers will go elsewhere.",
    "He's said so himself, but I'll sell when the price suits me. A miller sets his own price.",
    "Let him look elsewhere then. Few mills lie close and he knows it.",
    "You're young and you see how they scowl at us. I won't change. There's no point asking.",
    "A miller takes a share of every sack and people resent it. They can't do without us all the same.",
    "We've owned this farm for generations and no lord has a claim on it. That's why I hold it dear.",
    "That's the family story, and it may be true. I'd have you remember where the coin came from.",
    "Frost kills the tender plants, and weeds choke what's left. The garden must be clean before winter.",
    "We farm for the abbey and never learned our letters. It's a shame to see words on the wall we can't read.",
    "The abbey gives us food and shelter. A blessing is the least we can offer in return.",
    "I earn my living by cutting and mending. Today I had three patients and every one will recover.",
    "You've been handling wounds all day. Dirty hands spoil the bread and give us all a fever.",
    "Water cracks my hands and wastes my time. Blood on my fingers means I've worked.",
    "I've heard people say that. A healer sometimes has to cut deep to cure, and not everyone understands.",
    "We have a large order and it's due soon. Rivets are the quickest work, so we'll start there.",
    "You promised the same last time and fell asleep over the work. I'd like to see you finish this time.",
    "Reading protects you from false contracts and crooked deals. A man without letters must believe whatever he's told.",
    "You're welcome here. Nobody's sat at our table in many months. It's good to have a visitor.",
    "The duke rides out on Thursday and the hounds must be strong and quick. If one is lame, I'll hear about it.",
    "A bitch in whelp is no good for the hunt. We'll keep her by the fire and hope the boars stay away.",
    "Merchants hear everything on the roads. He says the south is at war, though I don't know how far it will spread.",
    "Our pass is high and the wind is bitter. Sit by the fire and warm your hands before you go on."
};

stock Families_GetTalkAnswerCount(family)
{
    return family >= 0 && family < FAMILY_SEED_HOUSEHOLDS ? sizeof(s_FamilyTalkAnswers[]) : 0;
}

stock bool:Families_FormatTalkAnswer(family, choice, dest[], size = sizeof(dest))
{
    dest[0] = EOS;

    if (choice < 0 || choice >= Families_GetTalkAnswerCount(family))
    {
        return false;
    }

    Families_FormatText(family,s_FamilyTalkAnswers[family][choice],dest,size);
    return true;
}

stock bool:Families_FormatTopicAnswer(topic, dest[], size = sizeof(dest))
{
    dest[0] = EOS;

    if (topic < 0 || topic >= FAMILY_SEED_TOPICS)
    {
        return false;
    }

    Families_FormatText(g_FamilyTopicDefs[topic][E_FAMILY_TOPIC_DEF_FAMILY],s_FamilyTopicAnswers[topic],dest,size);
    return true;
}

stock Families_VoiceFamily(owner)
{
    return owner >= 0 && owner < FAMILY_SEED_MEMBERS ? Families_GetMemberFamily(owner) : 0;
}

stock Families_GetVoiceOwner(actor)
{
    new member = Families_GetMemberOfActor(actor);

    if (member != -1)
    {
        return member;
    }

    new key[ACTORS_KEY_LEN];
    Actors_GetKey(actor,key);

    if (key[0] == EOS)
    {
        return -1;
    }

    for (new i = 0;i < FAMILY_SEED_VOICE_ACTORS;i++)
    {
        if (!strcmp(key,g_FamilyVoiceActorKeys[i]))
        {
            return FAMILY_SEED_MEMBERS + i;
        }
    }

    return -1;
}

stock bool:Families_HasVoice(member,slot)
{
    return member >= 0 && member < FAMILY_SEED_VOICES && slot >= 0 && slot < _:FAMILY_VOICE_COUNT && g_FamilyVoiceIndex[member][slot] != -1;
}

stock bool:Families_FormatVoice(member,slot,dest[],size)
{
    dest[0] = EOS;

    if (!Families_HasVoice(member,slot))
    {
        return false;
    }

    Families_FormatText(Families_VoiceFamily(member),g_FamilyVoiceText[g_FamilyVoiceIndex[member][slot]],dest,size);
    return true;
}

stock Families_GetVoiceTrait(member,dest[],size = sizeof(dest))
{
    dest[0] = EOS;

    if (member < 0 || member >= FAMILY_SEED_VOICES || g_FamilyVoiceTraits[member] < 0)
    {
        return -1;
    }

    strcopy(dest,g_FamilyTraitNames[g_FamilyVoiceTraits[member]],size);
    return g_FamilyVoiceTraits[member];
}

stock Families_GetTradeRowCount(member)
{
    return member >= 0 && member < FAMILY_SEED_VOICES ? g_FamilyTradeSpans[member][1] : 0;
}

stock Families_GetMemberTradeRow(member,choice)
{
    if (choice < 0 || choice >= Families_GetTradeRowCount(member))
    {
        return -1;
    }

    return g_FamilyTradeSpans[member][0] + choice;
}

stock Families_GetTradeRowMember(row)
{
    return row >= 0 && row < FAMILY_SEED_TRADE_ROWS ? g_FamilyTradeRowDefs[row][E_FAMILY_TRADE_ROW_MEMBER] : -1;
}

stock Families_GetTradeRowAction(row)
{
    return row >= 0 && row < FAMILY_SEED_TRADE_ROWS ? g_FamilyTradeRowDefs[row][E_FAMILY_TRADE_ROW_ACTION] : -1;
}

stock bool:Families_FormatTradeQuestion(row,dest[],size = sizeof(dest))
{
    dest[0] = EOS;

    if (row < 0 || row >= FAMILY_SEED_TRADE_ROWS)
    {
        return false;
    }

    strcopy(dest,g_FamilyTradeRowDefs[row][E_FAMILY_TRADE_ROW_QUESTION],size);
    return true;
}

stock bool:Families_FormatTradeAnswer(row,dest[],size = sizeof(dest))
{
    dest[0] = EOS;

    if (row < 0 || row >= FAMILY_SEED_TRADE_ROWS)
    {
        return false;
    }

    Families_FormatText(Families_VoiceFamily(g_FamilyTradeRowDefs[row][E_FAMILY_TRADE_ROW_MEMBER]),g_FamilyTradeRowDefs[row][E_FAMILY_TRADE_ROW_ANSWER],dest,size);
    return true;
}
