new const g_FamilyErrandDefs[FAMILY_SEED_ERRANDS][E_FAMILY_ERRAND_DEF] = {
	{0, 0, 0, "My back won't take the forest today. Bring me six bundles of firewood for the hearth?", ITEM_FIREWOOD, 6, 6, 10, -1},
	{0, 1, 2, "Take this bit of cheese to the baker's wife. She sent bread when the little one was sick.", ITEM_PARCEL, 1, 3, 8, 14},
	{0, 0, 2, "The pottage pot will be bare by Thursday. Two bundles of onions would give it some taste.", ITEM_ONION, 2, 4, 8, -1},
	{0, 0, 1, "My bones ache in the damp. A little honey for my tea would help, if you find any.", ITEM_HONEY, 1, 5, 9, -1},
	{1, 0, 6, "I'm out of good wool. Three fleeces, and I'll pay you for the trouble.", ITEM_FLEECE, 3, 12, 10, -1},
	{1, 1, 8, "Would you take this skein to the tailor's wife? She asked for it last week.", ITEM_PARCEL, 1, 3, 6, 37},
	{1, 0, 7, "I'd like flax for the next linen. Two bundles from the field, if you could.", ITEM_FLAX, 2, 8, 9, -1},
	{1, 1, 6, "Carry this folded cloth to the reeve's wife. It's the order she asked for.", ITEM_PARCEL, 1, 4, 8, 10},
	{2, 0, 9, "I'm short of parchment for the rolls. Two sheets would save me a trip.", ITEM_PARCHMENT, 2, 15, 12, -1},
	{2, 1, 10, "Take this note to the merchant's wife, would you? It's about the ribbon. Don't read it.", ITEM_PARCEL, 1, 4, 8, 39},
	{2, 0, 11, "Father wants ink and quills, but I'm only to ask for candles. Two would let me read at night.", ITEM_CANDLE, 2, 6, 8, -1},
	{2, 1, 9, "Carry this sealed roll to the smith. It's the count's tax notice. Don't let him read it before he's calm.", ITEM_PARCEL, 1, 5, 9, 48},
	{3, 0, 13, "The oven's hungry again. Four bundles of firewood would see me through tomorrow.", ITEM_FIREWOOD, 4, 5, 10, -1},
	{3, 0, 14, "The dough's going flat without salt. Bring me some and there's bread in it for you.", ITEM_SALT, 1, 4, 8, -1},
	{3, 0, 13, "The rye's low. Bring me two sacks of rye from the farms and you'll have loaves for a week.", ITEM_RYE, 2, 8, 10, -1},
	{3, 1, 14, "Take this warm loaf to the herdsman's wife. Her children are always hungry.", ITEM_PARCEL, 1, 2, 9, 26},
	{4, 0, 16, "I'm short of planks. Bring me four and I'll pay you a few coins.", ITEM_PLANK, 4, 10, 10, -1},
	{4, 0, 17, "We need nails for the scaffold. Five, if you can find them.", ITEM_NAILS, 5, 8, 8, -1},
	{4, 0, 18, "We've no firewood left for the stew. Could you bring three bundles?", ITEM_FIREWOOD, 3, 4, 8, -1},
	{4, 1, 16, "Take this measure stick to the mason's journeyman. He left it here last week.", ITEM_PARCEL, 1, 3, 7, 33},
	{5, 0, 19, "Tomorrow's a fast day and the kitchen has no fish. Two fish would save me.", ITEM_FISH, 2, 10, 10, -1},
	{5, 0, 20, "The taproom eats candles. Bring me three and I'll pay well.", ITEM_CANDLE, 3, 9, 8, -1},
	{5, 0, 19, "The ale's running low. Bring me three from the brewer before the guests notice.", ITEM_ALE, 3, 9, 9, -1},
	{5, 1, 21, "Take this jug to the brewer's wife. It's about the spoiled barrel. She'll know.", ITEM_PARCEL, 1, 3, 7, 45},
	{6, 0, 23, "I'm out of clay. Four lumps from the clay pit and I can sit at the wheel again.", ITEM_CLAY, 4, 8, 10, -1},
	{6, 0, 24, "The kiln wants charcoal. Two baskets, if you can spare the walk.", ITEM_CHARCOAL, 2, 8, 8, -1},
	{6, 0, 23, "The stew pot is cracked. I'd like a good iron pot in its place, for my wife's sake.", ITEM_POT, 1, 8, 9, -1},
	{6, 1, 24, "Carry this jug to the innkeeper's son. It's a sample of the mugs.", ITEM_PARCEL, 1, 3, 7, 22},
	{7, 0, 25, "I need feed for the byre. Bring me three sacks of oats and I'll see you right.", ITEM_OATS, 3, 9, 10, -1},
	{7, 1, 26, "Take this milk to the old couple by the hamlet. They can't walk to us any more.", ITEM_PARCEL, 1, 4, 10, 100},
	{7, 0, 26, "The children want a bit of honey on their bread. If you find any, I'll pay what I can.", ITEM_HONEY, 1, 5, 8, -1},
	{7, 1, 25, "Take this fresh cheese to the baker. We owe him for bread.", ITEM_PARCEL, 1, 3, 8, 13},
	{8, 0, 29, "I need wax to seal the cider jars. A cake of wax would do.", ITEM_WAX, 1, 6, 8, -1},
	{8, 1, 30, "These apples are for the brewer. He promised us a jug of cider for them.", ITEM_PARCEL, 1, 3, 8, 44},
	{8, 0, 30, "Our bread has gone stale. A few fresh loaves from the baker would be welcome.", ITEM_BREAD, 2, 2, 8, -1},
	{8, 1, 29, "Take a basket of these windfalls to the carpenter's boys. They've no mother to bake for them.", ITEM_PARCEL, 1, 3, 9, 18},
	{9, 0, 31, "I'm short of cut stone for the castle job. Four blocks and I'll pay you fairly.", ITEM_STONE_BLOCK, 4, 14, 10, -1},
	{9, 1, 33, "Take my master's measurements to the carpenter. He needs them for the scaffold.", ITEM_PARCEL, 1, 3, 6, 16},
	{9, 0, 32, "We need salt to cure the pork. A small bag would do.", ITEM_SALT, 1, 5, 8, -1},
	{9, 1, 31, "Take this plan to the reeve. It's the count's wall and he must sign.", ITEM_PARCEL, 1, 5, 9, 9},
	{10, 0, 34, "My rope's frayed through. Bring me two good ropes and I'll owe you.", ITEM_ROPE, 2, 8, 10, -1},
	{10, 0, 35, "The clamp needs kindling to start. Six bundles, if you're out that way.", ITEM_KINDLING, 6, 6, 8, -1},
	{10, 0, 34, "The fire's nearly out. My axe is too dull to split, so I need four bundles of firewood.", ITEM_FIREWOOD, 4, 4, 8, -1},
	{10, 1, 35, "Take this basket of charcoal to the smith. He's been waiting a week.", ITEM_PARCEL, 1, 4, 8, 48},
	{11, 0, 36, "I need linen for the clerk's coat lining. Two lengths and you'll be paid.", ITEM_LINEN, 2, 12, 10, -1},
	{11, 1, 37, "Take this mended shirt to the smith's apprentice. He tore it on the anvil.", ITEM_PARCEL, 1, 3, 6, 50},
	{11, 0, 37, "I need onion skins for the yellow dye pot. Bring three onions and I'll pay.", ITEM_ONION, 3, 4, 8, -1},
	{11, 1, 36, "Take this new tunic to the herdsman. He's paid half already and owes the rest.", ITEM_PARCEL, 1, 5, 9, 25},
	{12, 0, 38, "Bring me two bags of salt for an order I have to fill. I'll pay a fair price.", ITEM_SALT, 2, 12, 10, -1},
	{12, 1, 40, "Take this ledger page to the reeve's clerk. It's what the count owes us.", ITEM_PARCEL, 1, 4, 8, 9},
	{12, 0, 38, "A buyer wants sealing wax. Bring me good cakes of it. I'll pay fairly.", ITEM_WAX, 2, 12, 10, -1},
	{12, 1, 39, "Take this note to the tailor, it's for a cloak. He'll know the cloth.", ITEM_PARCEL, 1, 4, 8, 36},
	{13, 0, 43, "I'm short of staves for the brewer's barrels. Bring me six.", ITEM_STAVE, 6, 10, 10, -1},
	{13, 0, 42, "My chest hurts in the cold. Bring me some herbs from the wood, would you?", ITEM_HERBS, 2, 4, 12, -1},
	{13, 0, 43, "Two bundles of willow bark for the hoops, please. I'll pay.", ITEM_BARK, 2, 6, 8, -1},
	{13, 1, 42, "Take this little keg to the innkeeper. He ordered it and I'm too stiff to walk.", ITEM_PARCEL, 1, 5, 9, 19},
	{14, 0, 44, "I need barley for the next mash. Two sacks and you'll drink free tonight.", ITEM_BARLEY, 2, 8, 10, -1},
	{14, 0, 45, "Not a hop left in the loft. Bring me two bundles.", ITEM_HOPS, 2, 8, 8, -1},
	{14, 0, 45, "The honey's gone from the mead jar. A small crock would do. I'll pay well.", ITEM_HONEY, 1, 6, 9, -1},
	{14, 1, 44, "Take this jug to the cooper. It's a sample of the new ale. He can tell me how the barrel holds it.", ITEM_PARCEL, 1, 4, 8, 43},
	{15, 0, 48, "I'm short of charcoal for the forge. Three baskets and I'll pay you.", ITEM_CHARCOAL, 3, 10, 10, -1},
	{15, 0, 50, "We're out of iron bars and I daren't tell the master. Bring me two?", ITEM_IRON_BAR, 2, 12, 10, -1},
	{15, 0, 48, "I need nails for the horseshoes. Six, and I'll pay.", ITEM_NAILS, 6, 8, 9, -1},
	{15, 1, 49, "Take this new knife to the cooper. He ordered it a month ago.", ITEM_PARCEL, 1, 4, 8, 43},
	{16, 0, 51, "No seed turnips means no supper this winter. Bring me two turnips to plant.", ITEM_TURNIP, 2, 4, 12, -1},
	{16, 1, 52, "Take this bit of wool to the dyer sisters. They're weaving us a blanket for the little ones.", ITEM_PARCEL, 1, 3, 8, 55},
	{16, 0, 52, "The children have had no egg since a hen stopped laying. Bring me three eggs from anyone who'll sell them.", ITEM_EGGS, 3, 5, 10, -1},
	{16, 1, 51, "Take this sack of turnip tops to the baker. Svatava will give a loaf for them. It's for the children.", ITEM_PARCEL, 1, 3, 8, 60},
	{17, 0, 55, "I can't fix the colour without alum, but flax will do for now. Bring me two bundles of flax.", ITEM_FLAX, 2, 8, 10, -1},
	{17, 1, 56, "Take this blue skein to Pavel the weaver in Talmberg. Tell him it's a gift, this once.", ITEM_PARCEL, 1, 4, 8, 6},
	{17, 0, 55, "The loom wants a new shuttle cord. Bring me a good length of rope and I'll pay you in coin.", ITEM_ROPE, 1, 5, 8, -1},
	{17, 1, 56, "Take this cloth to Svickar the chandler. The wife ordered it for wrapping the church candles.", ITEM_PARCEL, 1, 5, 9, 64},
	{18, 0, 59, "I need yew staves, or ash if you can't find yew. Bring me two branches, the straightest you can.", ITEM_BRANCH, 2, 6, 10, -1},
	{18, 0, 57, "Planks for the wheel rims. Three would do it.", ITEM_PLANK, 3, 9, 10, -1},
	{18, 0, 59, "String is short. Bring me a length of hemp rope and I'll twist bowstrings from it.", ITEM_ROPE, 1, 5, 8, -1},
	{18, 0, 57, "I'm short of nails for the cart bed. Bring me two bundles.", ITEM_NAILS, 2, 8, 10, -1},
	{19, 0, 60, "My oven needs wood and my back's no good for it. Five bundles, love.", ITEM_FIREWOOD, 5, 6, 12, -1},
	{19, 0, 61, "We need wheat for the feast loaves. Two sacks would do.", ITEM_WHEAT, 2, 8, 10, -1},
	{19, 0, 60, "A rye loaf wants caraway, which we don't grow. Bring two bundles of herbs from the woods and I'll bake you a ring for it.", ITEM_HERBS, 2, 5, 9, -1},
	{19, 1, 61, "Take this basket of pretzel rings to Otakar at the Hare. He'll pay you my fee. Count it before you leave.", ITEM_PARCEL, 1, 4, 9, 67},
	{20, 0, 62, "I'm out of herbs. Bring me four bundles from the woods and I'll owe you a remedy.", ITEM_HERBS, 4, 8, 12, -1},
	{20, 1, 62, "Take this remedy to the miner's old father in the hamlet. His cough is worse.", ITEM_PARCEL, 1, 4, 10, 98},
	{20, 0, 62, "Honey for the cough syrup. Bring me one pot and I'll pay you in coin.", ITEM_HONEY, 1, 8, 10, -1},
	{20, 1, 62, "Take this linen with salve to the crofters, Dvorak. The littlest one has a rash.", ITEM_PARCEL, 1, 3, 9, 52},
	{21, 0, 63, "Tallow's short. Bring me three lumps of fat and I'll pay you in coin, not candles.", ITEM_FAT, 3, 10, 10, -1},
	{21, 0, 64, "Wax for the church candles. Two cakes of it.", ITEM_WAX, 2, 12, 10, -1},
	{21, 0, 63, "I need fine, strong flax for the wicks. Bring me two bundles and I'll pay you in coin.", ITEM_FLAX, 2, 8, 10, -1},
	{21, 1, 65, "Take this candle to the baker's widow, for the oven shrine. Tell her it's from us.", ITEM_PARCEL, 1, 4, 9, 60},
	{22, 0, 67, "The barrel's dry for tonight. Bring me two jugs of ale and you drink free.", ITEM_ALE, 2, 8, 10, -1},
	{22, 0, 68, "The guests want sausage and I've no pork. Bring me some and I'll stuff it.", ITEM_MEAT_PORK, 2, 8, 8, -1},
	{22, 0, 67, "The Hare's own batch is half made and I'm short of hops. Bring me two bundles.", ITEM_HOPS, 2, 6, 9, -1},
	{22, 1, 68, "Take this jug of ale to the carpenters, the Kolars. Benes ordered it and he'll give you a coin.", ITEM_PARCEL, 1, 4, 9, 57},
	{23, 0, 69, "I've run out of bait. Bring me four handfuls and I'll give you a fish for your trouble.", ITEM_BAIT, 4, 5, 10, -1},
	{23, 1, 70, "Take this smoked eel to the innkeeper in Talmberg. He's paid already.", ITEM_PARCEL, 1, 4, 8, 19},
	{23, 0, 69, "My boat leaks. Bring me two ropes to bind the planks and I'll give you a good pull of eel.", ITEM_ROPE, 2, 6, 10, -1},
	{23, 0, 70, "Fish and no salt tastes of mud. A bag of salt, and I'll spare you a smoked trout.", ITEM_SALT, 1, 5, 9, -1},
	{24, 0, 73, "I need straw bundles, but I'll take rope to bind them if you've none. Two ropes.", ITEM_ROPE, 2, 6, 10, -1},
	{24, 0, 74, "We're short of firewood. Three bundles would keep the damp out.", ITEM_FIREWOOD, 3, 4, 8, -1},
	{24, 0, 73, "The straw's rotting in the damp. Bring me two good planks to stand the bundles on, and I'll pay.", ITEM_PLANK, 2, 7, 10, -1},
	{24, 1, 74, "Take this loaf of rye to the widow Bylinkarka. It's thanks for the herbs she sent.", ITEM_PARCEL, 1, 3, 8, 62},
	{25, 0, 75, "I'm short of salt again. Bring me two and the meat keeps till spring.", ITEM_SALT, 2, 10, 10, -1},
	{25, 1, 77, "Take these sausages to the alehouse keeper over the hill. He's paid for them already.", ITEM_PARCEL, 1, 4, 8, 67},
	{25, 0, 75, "I've rendered all the fat I have and the candles want more. Bring me two measures of fat.", ITEM_FAT, 2, 8, 10, -1},
	{25, 1, 78, "Take this blood pudding to the Medars. It's for their daughter's name day.", ITEM_PARCEL, 1, 4, 8, 83},
	{26, 0, 80, "The tubs want bark. Bring me four strips of good oak bark and I'll pay you.", ITEM_BARK, 4, 8, 10, -1},
	{26, 0, 81, "There's no work without cow hides. Bring two if you can find them.", ITEM_HIDE_COW, 2, 12, 10, -1},
	{26, 0, 80, "The hides take a lot of salt. Bring me two measures and I'll pay for it.", ITEM_SALT, 2, 9, 10, -1},
	{26, 1, 81, "Take this strip of soft leather to the cobbler in Talmberg. Don't get it wet.", ITEM_PARCEL, 1, 5, 8, 36},
	{27, 0, 84, "I need smoke for the skeps. Bring me four bundles of kindling.", ITEM_KINDLING, 4, 5, 10, -1},
	{27, 1, 83, "Take this honey to the chandler's wife over the hill. She paid for it.", ITEM_PARCEL, 1, 4, 8, 64},
	{27, 0, 84, "The wax-press needs good flat planks. Bring me two and I'll pay in coin and a honey cake.", ITEM_PLANK, 2, 6, 10, -1},
	{27, 1, 82, "Take this crock of honey to the old couple at the Stary house. A kindness, no payment.", ITEM_PARCEL, 1, 2, 12, 100},
	{28, 0, 86, "There's nothing in the house for tomorrow. Two loaves of bread would feed the little ones.", ITEM_BREAD, 2, 2, 15, -1},
	{28, 0, 85, "We're short of firewood. Four bundles would get us through the cold nights.", ITEM_FIREWOOD, 4, 3, 12, -1},
	{28, 0, 86, "Kaspar has no warm hose. One length of linen would make a pair. Bring it if you can.", ITEM_LINEN, 1, 3, 12, -1},
	{28, 1, 85, "Take this basket of turnips to the Stary house. They've nobody to dig for them.", ITEM_PARCEL, 1, 2, 12, 99},
	{29, 0, 88, "My lambs need a dose. Bring me two bundles of herbs from the woods.", ITEM_HERBS, 2, 5, 10, -1},
	{29, 1, 89, "Take these fleeces to Pavel the weaver in Talmberg. He's paid half already.", ITEM_PARCEL, 1, 4, 8, 6},
	{29, 0, 88, "Wolves keep coming. Bring me four torches and I'll scare them off the high fold.", ITEM_TORCH, 4, 8, 10, -1},
	{29, 0, 89, "We're out of salt for the cheese. Bring a bag and I'll give you a wedge.", ITEM_SALT, 1, 5, 9, -1},
	{30, 0, 92, "I'm out of arrows. Ten good ones and I'll share the next kill.", ITEM_ARROW, 10, 8, 10, -1},
	{30, 0, 93, "We need salt to cure the meat. Two bags of it.", ITEM_SALT, 2, 8, 8, -1},
	{30, 0, 92, "I can't spear a boar with split shafts. Bring me three branches of ash if you can find them.", ITEM_BRANCH, 3, 6, 10, -1},
	{30, 1, 93, "Take this wrapped venison to the Reznik butcher. Tell him it's not from the count's wood.", ITEM_PARCEL, 1, 6, 8, 75},
	{31, 0, 94, "I'm out of torches for the shaft. Bring me two.", ITEM_TORCH, 2, 6, 10, -1},
	{31, 0, 98, "I need herbs for my chest, stranger. Two bundles, the widow says they help.", ITEM_HERBS, 2, 4, 12, -1},
	{31, 0, 94, "The shaft props are rotting. Bring me two beams of sound oak and I'll pay what I can.", ITEM_BEAM, 2, 12, 12, -1},
	{31, 1, 96, "Take this iron bar to the smith in Talmberg. He's paid for it already.", ITEM_PARCEL, 1, 5, 8, 48},
	{32, 0, 100, "We've no firewood and these old arms won't swing an axe. Three bundles?", ITEM_FIREWOOD, 3, 3, 15, -1},
	{32, 0, 99, "Bring us eggs from someone with younger hens than ours. Two will do.", ITEM_EGGS, 2, 3, 12, -1},
	{32, 0, 100, "We haven't tasted cheese since the harvest. A wedge would be a feast, if you can spare it.", ITEM_CHEESE, 1, 3, 14, -1},
	{32, 1, 99, "Take this knotted rosary to the priest's bench in Talmberg. Tell the clerk it's a gift for the church.", ITEM_PARCEL, 1, 2, 10, 9},
	{33, 0, 101, "I need linen to patch the sail. Bring two lengths and I'll grind your grain for nothing.", ITEM_LINEN, 2, 10, 10, -1},
	{33, 1, 104, "Take this sack of flour to the baker in Talmberg. Tell him it's sifted.", ITEM_PARCEL, 1, 4, 8, 13},
	{33, 0, 101, "The millstones need dressing with a good iron bar. Bring me one and I'll grind your grain free for a month.", ITEM_IRON_BAR, 1, 10, 10, -1},
	{33, 1, 103, "Take this sack of fine flour to the Medar house. They're baking for the church feast.", ITEM_PARCEL, 1, 4, 8, 82},
	{34, 0, 106, "Oats for the oxen. Three sacks and I'll pay you as I pay my hands.", ITEM_OATS, 3, 10, 10, -1},
	{34, 1, 108, "Would you take these eggs down the road to the abbey's tenants? We help our neighbours here.", ITEM_PARCEL, 1, 3, 8, 115},
	{34, 0, 108, "The hens aren't laying much. Bring me a sack of barley for their feed and I'll pay you coin.", ITEM_BARLEY, 1, 6, 9, -1},
	{34, 1, 106, "Take this ham to the Klasterny tenants. They've geese to rear and little to spare. Say it's from Dominik, and don't wait for thanks.", ITEM_PARCEL, 1, 4, 9, 114},
	{35, 0, 114, "Geese need grain. Bring me two sacks of oats for the flock.", ITEM_OATS, 2, 6, 10, -1},
	{35, 0, 115, "Herbs for the monks' kitchen. Three bundles would please Brother Hugh.", ITEM_HERBS, 3, 6, 10, -1},
	{35, 0, 115, "The hens want grain and the barn's bare. Bring me a sack of barley, and I'll cook you a supper of it.", ITEM_BARLEY, 1, 5, 9, -1},
	{35, 1, 114, "Take this cheese to the Sedlak farm. Dominik lent us a plough hand and wants nothing for it. Give it to him quietly.", ITEM_PARCEL, 1, 3, 8, 106},
	{36, 0, 116, "I need linen for bandages. Two lengths of it.", ITEM_LINEN, 2, 12, 10, -1},
	{36, 0, 117, "I'm out of herbs for the poultices. Bring me three bundles.", ITEM_HERBS, 3, 8, 10, -1},
	{36, 0, 116, "I need a clean pot for the salves and a bit of fat to melt into them. Bring me a pot.", ITEM_POT, 1, 10, 10, -1},
	{36, 1, 117, "Take this linen roll to the herb widow in the village. Not a word to Kasimir. It's a gift, she'll know why.", ITEM_PARCEL, 1, 4, 10, 62},
	{37, 0, 118, "I need iron. Bring me three bars and I'll pay what the duke pays.", ITEM_IRON_BAR, 3, 18, 10, -1},
	{37, 0, 120, "Charcoal for the rivet forge. Three baskets.", ITEM_CHARCOAL, 3, 10, 8, -1},
	{37, 0, 120, "Coal's one thing. The quench barrel leaks too. Bring me a bucket, a good one, that holds water.", ITEM_BUCKET, 1, 6, 8, -1},
	{37, 1, 118, "Take this iron buckle to the huntsman, Lesmistr. It's for the duke's hunting belt. He's waiting on it.", ITEM_PARCEL, 1, 5, 10, 124},
	{38, 0, 122, "I'm short of parchment. Bring me three sheets and I can finish the duke's letters.", ITEM_PARCHMENT, 3, 18, 10, -1},
	{38, 1, 123, "Take this sealed letter to the reeve's clerk in Talmberg. Don't break the seal.", ITEM_PARCEL, 1, 6, 10, 9},
	{38, 0, 122, "I need beeswax for the duke's seals. Bring me two cakes and I'll pay well.", ITEM_WAX, 2, 14, 10, -1},
	{38, 1, 122, "Take this packet to the Lesmistr house, to the huntsman. It lists the duke's hunting dues. Don't open it.", ITEM_PARCEL, 1, 6, 10, 124},
	{39, 0, 124, "I need ten arrows for the hunt. Straight ones, mind.", ITEM_ARROW, 10, 10, 10, -1},
	{39, 0, 127, "Can you bring meat for the hounds? Two cuts of venison, please.", ITEM_MEAT_VENISON, 2, 10, 8, -1},
	{39, 0, 124, "Three torches for the night hunt, if you can. I'll pay in coin or a haunch of hare.", ITEM_TORCH, 3, 8, 9, -1},
	{39, 1, 125, "Take this smoked venison to the barber-surgeon's house, to Kordula. Her husband set my cousin's leg and wants no pay.", ITEM_PARCEL, 1, 5, 10, 117},
	{40, 0, 128, "Up here we burn more wood than any house in the county. Bring me six bundles.", ITEM_FIREWOOD, 6, 8, 10, -1},
	{40, 0, 129, "The travellers' horses are eating us out of oats. Bring me two sacks.", ITEM_OATS, 2, 6, 8, -1},
	{40, 0, 129, "Cheese for the travellers' supper. Bring me three wheels and I'll pay in coin.", ITEM_CHEESE, 3, 12, 9, -1},
	{40, 1, 128, "Take this letter to Kancler the scribe in the lowland. A merchant left it here for the duke's clerk and wants it passed on.", ITEM_PARCEL, 1, 6, 10, 122}
};

new const g_FamilyGraces[FAMILY_SEED_GRACES][128] = {
	"Bless us, O Lord, and these thy gifts, which we are about to receive from thy bounty.",
	"Benedic, Domine, nos et haec tua dona. Bless this table and those who sit at it.",
	"For what we are about to eat, may the Lord make us thankful.",
	"Lord, bless this bread and the hands that made it.",
	"Benedicite. Lord, bless this bread and keep our house from want.",
	"Gratias tibi, Deus, for field and fire. Bless what we eat and those who sit to it.",
	"Lord, we are poor and thankful. Bless this food, and guard the road home for the traveller.",
	"Pater noster, give us this day our daily bread, and forgive us our debts as we forgive our neighbours.",
	"Come, Lord, be our guest at this table. Bless the cook, the cup and the stranger among us.",
	"Agimus tibi gratias. For the work of our hands and the rain on our fields, we thank thee, Lord."
};

enum E_FAMILY_QUESTION_DEF
{
	E_FAMILY_QUESTION_DEF_TEXT[128],
}

new const g_FamilyQuestionDefs[FAMILY_SEED_QUESTIONS][E_FAMILY_QUESTION_DEF] = {
	{"So, stranger, where are you from?"},
	{"What do you make of the new tax?"},
	{"Have you heard any news on the road?"},
	{"Do you go to mass?"},
	{"Are you good with your hands?"},
	{"Is the food to your liking?"},
	{"Will you be staying in these parts?"},
	{"Have you seen a thief about? Something's gone missing."},
	{"Do you have family of your own?"},
	{"What brings you to our door?"},
	{"Who is the best neighbour a man could have, do you think?"},
	{"Does the road to Talmberg still seem safe to you?"},
	{"Have you tasted the new ale this year?"},
	{"What would you do with an extra pfennig, guest?"},
	{"Do you think it will be a hard winter?"},
	{"Have you ever seen the count, guest?"},
	{"Do you say a prayer before a long road?"},
	{"What's the best food you remember from your childhood?"},
	{"Would you help a man whose cart is stuck in the mud?"},
	{"Do you know any songs, guest?"},
	{"Is a clean wage better than a good harvest?"},
	{"What do you make of the wolves these days?"}
};

enum E_FAMILY_ANSWER_DEF
{
	E_FAMILY_ANSWER_DEF_TEXT[64],
	E_FAMILY_ANSWER_DEF_FAVOUR,
	E_FAMILY_ANSWER_DEF_REPLY[128],
}

new const g_FamilyAnswerDefs[FAMILY_SEED_ANSWERS][E_FAMILY_ANSWER_DEF] = {
	{"From far away. I'm still finding my feet here.", 3, "Then you've come to the right table. Eat."},
	{"That's my business.", -3, "Suit yourself."},
	{"From a village like this one. It burned.", 5, "God keep you. You'll find no fire here."},
	{"The count needs his coin, I suppose.", -2, "Easy to say with a full purse."},
	{"It's robbery, plain and simple.", 4, "Say that louder at the castle and see what happens."},
	{"I keep my head down and pay.", 1, "Wise. Most of us do the same."},
	{"Only that the roads are dangerous after dark.", 2, "They always are. Carry a light."},
	{"There's talk of wolves in the high pasture.", 3, "The shepherd said the same. God help his lambs."},
	{"Nothing worth repeating at a table.", 0, "Then it's not worth repeating anywhere."},
	{"Every Sunday, without fail.", 4, "Good. The Lord sees who comes."},
	{"When I can.", 1, "That's honest at least."},
	{"The priest can pray for me.", -4, "He'll have his work cut out."},
	{"I can turn my hand to most things.", 3, "Then we may have a job for you, if you're willing."},
	{"I'm better with a sword.", -1, "We've little use for swords at this table."},
	{"I'm learning.", 2, "Everyone starts somewhere."},
	{"It's the best I've had in weeks.", 5, "Ha! Then you've been eating badly."},
	{"It fills the belly.", 1, "Fair enough. That's all I ask of it too."},
	{"It could use more salt.", -3, "Then bring your own salt next time."},
	{"I hope to. I like it here.", 4, "Then we'll see you at the table again."},
	{"Until something better comes along.", -2, "Nothing better ever comes along. Trust me."},
	{"I go where the work is.", 1, "So do we all."},
	{"I'll keep an eye out for you.", 4, "Bless you. Tell the guards if you do."},
	{"Don't look at me.", -2, "I wasn't. Not until now."},
	{"Ask the guards, not a guest.", 0, "The guards ask for a coin before they ask a question."},
	{"Not yet. One day, God willing.", 3, "There's no shortage of good matches in the village."},
	{"I lost them.", 4, "I'm sorry. You're welcome at our table any time."},
	{"I'd rather not say.", 0, "Then I won't ask."},
	{"Hunger, to be honest.", 2, "Hunger I can fix. Come in and sit."},
	{"I wanted to meet my neighbours.", 5, "Then sit, neighbour, and welcome."},
	{"I was told you'd feed anyone.", -2, "I wouldn't say anyone. But you're here, so eat."},
	{"One who lends a hand unasked.", 4, "Aye. There are few of those left."},
	{"One who keeps his dog quiet.", 1, "A modest wish. I'd say a fair one."},
	{"One who lives far away.", -2, "Then you're in the wrong hamlet."},
	{"Safe by day, not by night.", 3, "That's what everyone says. Keep to the day."},
	{"I met nobody on it.", 1, "That's either good luck or a bad sign."},
	{"Safe enough for a brave man.", -1, "Brave men fill the churchyard."},
	{"I have. It was good.", 3, "Then the brewer's earned his coin."},
	{"A little thin, I thought.", 1, "Thin ale is the brewer's old trick."},
	{"I only drink water.", -1, "Water? That's a strange guest."},
	{"Buy bread for someone hungry.", 5, "God bless you. That's well said."},
	{"Save it for a rainy day.", 2, "A sensible head. Most have none."},
	{"Spend it at the alehouse.", -2, "Well, that's the honest answer."},
	{"The geese are flying early.", 3, "They are. My grandfather read it so too."},
	{"Winters are always hard.", 1, "True. Some are only worse."},
	{"I don't think about it.", -1, "You will, in January."},
	{"Once, riding past the village.", 2, "What was he like? Fat, I'd wager."},
	{"Never. And I'm glad.", 1, "A good place to be, out of his sight."},
	{"He's a friend of mine.", -3, "Then keep that quiet. And watch your purse."},
	{"Always. It brings luck.", 3, "Good. God walks the road with you."},
	{"Sometimes, if I remember.", 1, "God remembers, even when we don't."},
	{"Prayers won't stop a robber.", -3, "Maybe not. But they've saved a few."},
	{"My mother's barley stew.", 4, "Then she was a cook worth keeping."},
	{"Bread hot from the oven.", 2, "That's a smell worth a pfennig."},
	{"A feast I once saw. I only watched.", 1, "That's a hard way to remember a feast."},
	{"Gladly, mud or not.", 4, "Then you're worth ten of the gentry."},
	{"If he asked me politely.", 1, "A cautious soul. Fair enough."},
	{"Not in my good shoes.", -3, "Your shoes will dry. His cart won't."},
	{"A few. Shall I sing one?", 3, "Not at table, but after supper, yes!"},
	{"Only the church hymns.", 2, "Those are the best ones."},
	{"I sing badly.", 0, "All the better. We'll sing along."},
	{"Only a good harvest lasts.", 3, "True. A purse empties quicker than a barn."},
	{"A clean wage, for certain.", 1, "That's someone who's never farmed talking."},
	{"Both, and a third as well.", 0, "Greedy! But I see your point."},
	{"They're hungry, like us.", 3, "Aye. Hungry and nearer each winter."},
	{"They should be hunted.", 1, "Many say so. Few dare."},
	{"Wolves are no concern of mine.", -2, "Tell that to the shepherd."},
	{"Not so bad, it'll fill a sack", 3, "A sack is more than I hoped. Eat, eat."},
	{"I can't tell rye from grass", 0, "Then you're no farmer. Stay a guest."},
	{"Worse. You'll starve by winter", -4, "Mind your tongue at my table, stranger. We've not starved yet."},
	{"No, make him mend something for the potter", 4, "That's fair. He'll carry water for Zdenek's kiln. Matej, hear that?"},
	{"That's for his mother to say", 1, "It is. I'll say it later. Pass the bread."},
	{"Aye, beat him hard", -3, "Not in my house. He's thrown a stone, not robbed a church."},
	{"No, but I'd like one", 3, "A cow is worth ten sons. Don't tell my sons I said so."},
	{"I keep goats", 1, "Goats eat the thatch. Still, milk is milk."},
	{"Cows are nothing but trouble", -3, "Trouble! Child, you've never been hungry in a long winter."},
	{"Gladly, show me where", 5, "Good of you. Walk with Vojta, he'll show you the furrows."},
	{"Maybe after I've eaten", 1, "Then eat. The seed will still be there."},
	{"I'm a guest, not a hired hand", -3, "A guest eats and says thank you. Never mind then."},
	{"Tracks, but never the wolf", 2, "Tracks are enough to know they're out there. Bar the door, children."},
	{"None, and I'm not afraid", 0, "That's how the careless get eaten. Eat your bread."},
	{"Dozens, all as big as calves", -2, "Dozens! Now the children won't sleep. Thank you for that."},
	{"It's fair, a day for a day", 3, "A day for a day. You've a sensible head."},
	{"A smile is cheaper", 1, "My mother would agree. Mine's tired of smiling for oxen."},
	{"Take the ox, say nothing", -5, "Take it? That's stealing, friend. I won't have that here."},
	{"Keep her, a hen can be a friend", 3, "You see, Mother! The guest says so."},
	{"That's for your mother to decide", 1, "Mother always decides. That's no help."},
	{"Eat her, hens are food", -2, "I won't eat her! I won't! Not ever."},
	{"Never, I pay what I owe", 3, "I like that. It'll leave you poor, mind."},
	{"That's a risky question", 0, "It is, forget I asked. Pass the cheese."},
	{"Often, and more than a sheaf", -2, "Hush! Not so loud. The reeve's wife has long ears."},
	{"Gladly, I know it well", 4, "Then you're welcome. Bow your heads, children."},
	{"I'll listen quietly", 2, "That's kind enough. Keep your head bowed."},
	{"I don't hold with prayers", -4, "Then keep your thoughts to yourself in this house."},
	{"I'll bring you a few bundles", 5, "God bless you. Six bundles would see us through the week."},
	{"I've none to spare", 0, "No, nor have we. Forget it."},
	{"Burn the fence", -3, "And let the pig out? You're not a farmer."},
	{"No, I'd miss her", 2, "Me too! Mother, you hear?"},
	{"A goose is a goose", 0, "That's what Grandmother says. But Margaret is special."},
	{"Yes, and I'd laugh at your tears", -3, "That's mean! I'm not telling you any more."},
	{"Yes, I do, and I pray for them", 4, "God keep them. Don't let go of them."},
	{"Not yet, I'm lucky", 1, "Count yourself lucky while it lasts."},
	{"The dead are dead, why talk", -3, "Hard words. You'll understand them better when you're old."},
	{"Slowly, and far from the flame", 4, "Just so. You've a good eye."},
	{"I only know bread, not wool", 0, "Bread is a fine thing to know. Pass the cheese."},
	{"Just throw it on the coals", -4, "Throw wool on coals? You'd burn the village."},
	{"It's a good start, it'll improve", 4, "You think so? Mother never says that."},
	{"I can't tell yarn from string", 0, "Neither can the cat."},
	{"It's the worst I've seen", -4, "Oh. Well. Thank you for being honest, I suppose."},
	{"Of course, tell me what to say", 5, "Say Pavel wants woad, and he'll pay fairly. Don't haggle."},
	{"Perhaps, if I'm passing", 1, "Passing is something. Thank you."},
	{"I'm not your messenger", -3, "No, you're not. You're a guest."},
	{"The cloth, it keeps its worth", 3, "A wise answer. You'd make a weaver."},
	{"The cow, I like milk", 1, "Milk is fine. But it spoils by Sunday."},
	{"A purse of silver", -1, "Everybody wants a purse. That wasn't what I asked."},
	{"A smile does no harm", 2, "That's what I thought! Don't tell Father."},
	{"Ask your mother first", 1, "She'll say no. She says no to everything."},
	{"Never, a girl should be modest", -2, "Oh. Yes. I suppose that's what the priest says too."},
	{"Warm water and goose fat", 3, "We'll try the fat. Thank you."},
	{"A good night's rest", 1, "We'd all take that, if Johanka let us."},
	{"Cut them off", -3, "What a thing to say at table!"},
	{"I'll help with pleasure", 4, "You're kind. Sit by me. It's easy once you start."},
	{"My eyes are poor", 0, "Ah well. Eat your bread."},
	{"Bread is no pay for that", -2, "Bread's a fair wage in this house. Never mind."},
	{"I'll look and bring some", 4, "Good. A palmful will do."},
	{"I'll think about it", 1, "Think quickly. The creak keeps me awake."},
	{"Grease a loom? That's silly", -2, "It's not silly when you earn your bread by it."},
	{"Gladly, hand it here", 4, "Thank you. Tell Lida the colour is true."},
	{"Only if it's on my way", 1, "It's two doors down. It is on your way."},
	{"No, I'm busy eating", -2, "Then eat. Johanka will take it."},
	{"No, a price is a price", 3, "Right. Even a count's steward has coin."},
	{"Sell cheap, and stay safe", 1, "Safe, yes. It doesn't fill the purse, though."},
	{"Sell high, he's rich", -1, "It sounds good. It rarely goes well."},
	{"Not one counts as well as you", 2, "That's flattery, and I'll take it. Thank you."},
	{"I can't say, I've seen none", 0, "Then you're no judge of it. Eat."},
	{"They don't count, they guess", -2, "Careless men. I've said so for years."},
	{"Of course, always", 3, "Thank you. Mikulas, you hear that?"},
	{"It depends on the tailor", 0, "Clever. Mikulas will like that answer."},
	{"Credit is the best coin", -3, "A man who thinks that may find nobody wants to mend his coat."},
	{"Yes, it's a pretty gift", 2, "I think so too! Mother's too strict."},
	{"I'd ask my father first", 3, "That's what I should do. I'll ask Father tonight."},
	{"Never. A ribbon always comes with a debt", -2, "Debts? From a ribbon? You sound like Mother."},
	{"Long. God likes to be thanked properly", 4, "You speak like a clerk. Good."},
	{"As long as the meal is hot", 0, "Practical, I suppose. Hardly pious."},
	{"Short, I'm hungry", -2, "Hungry men are poor judges of piety."},
	{"When he's older, yes", 3, "That's what Father says too. 'When'. Always 'when'."},
	{"Not till he can read well", 1, "I read well! You don't know."},
	{"Yes, the earlier the better", -2, "I would like that. Mother would not."},
	{"Never, order is peace", 3, "That's kind of you. Few say so."},
	{"Sometimes, who wouldn't", 1, "I do. But somebody must."},
	{"Counting is for cowards", -3, "I'll thank you not to say it twice."},
	{"No, keep it quiet", 3, "Quite right. Wise words at last."},
	{"It depends who's listening", 1, "Yes, who's listening. That's what I keep telling him."},
	{"Shout it in the market", -4, "You'd get on well with Vojtech. And get hanged with him."},
	{"Try the priest, he has a stack", 3, "The priest? I'd not thought of it. Good."},
	{"I can't say", 0, "Nor can I. That's the trouble."},
	{"Use birch bark", -2, "Bark! The count would have me whipped."},
	{"Loud, crowded, full of sweets", 3, "Sweets! Mother, did you hear?"},
	{"I rarely go to fairs", 0, "Then you can't tell me anything. How dull."},
	{"Dull, nothing but thieves", -2, "Thieves? Mother will keep me home now."},
	{"Quiet. By dusk I'm worn out", 3, "I thought so. You sit well."},
	{"Noise, I like company", 0, "Noise we have. Plenty in the day."},
	{"I never sit still", -1, "You'd tire us all out then."},
	{"No, the count forgets debts", 3, "He does. You've seen the world."},
	{"A debt from a count is an honour", 1, "An honour doesn't feed a family."},
	{"Take his horse in payment", -3, "I'd be hanged. And so would you."},
	{"At first light", 3, "Good. You'd do for a baker. Dawn is late for us."},
	{"Whenever I wake", 0, "Lucky man. I envy you."},
	{"At noon, a gentleman's hour", -3, "At noon the whole village would be waiting on cold bread."},
	{"Eat it, bread is bread", 3, "Master, the guest says bread is bread!"},
	{"Feed it to the pig", 1, "The pig likes everything. That's no test."},
	{"Throw it out, it's foul", -2, "That's waste. Master would never forgive it."},
	{"Ask kindly, again and again", 3, "Just so. I'll tell Stepan."},
	{"Remind them at church", 2, "The priest would wince, but it works."},
	{"Take their pots in payment", -3, "We'd have pots piled to the rafters and nowhere to sit."},
	{"Not at all. Sift it, or take it back and complain", 3, "I'll sift it. But complaining gets me a worse sack."},
	{"Whatever's cheap", 0, "Cheap can cost more in the end. Mind that."},
	{"Grit adds strength", -3, "A fool's joke."},
	{"Hard, it keeps longer", 2, "A sensible man. Take the heel."},
	{"Soft, it's kinder on my teeth", 2, "Then take the middle. There's plenty."},
	{"I don't eat bread", -3, "Not eat bread? Are you ill?"},
	{"Yes, it's a duty", 4, "Good. Few manage it, but God sees."},
	{"A little, when I can", 1, "A little is better than none."},
	{"No, a man must eat", -2, "A man must eat. But Lent is Lent."},
	{"Yes, I'll bring some", 5, "Good man. I'll have loaves waiting for you."},
	{"Maybe tomorrow", 1, "Tomorrow's too late for the oven, but thanks."},
	{"I'm no woodcutter", -3, "We've enough workers who say so. Never mind."},
	{"Trade favours. That's what holds a village together", 4, "Aye. A village with no favours owed is just a heap of stones."},
	{"Keep accounts. Then nobody quarrels", 1, "Practical, I suppose, but cold."},
	{"Never give a thing for free", -3, "Hard heart. You'd not last in our parish."},
	{"Yes, many times", 3, "Then you know! You just start again, that's all."},
	{"I never bake", 0, "Never? Then you've missed the best smell in the world."},
	{"No, I'm too skilled", -2, "Too skilled, is it? Wait till your dough goes flat."},
	{"Very dear, the toll went up", 3, "The toll again. Thank you for the warning."},
	{"I didn't notice", 0, "Then you don't buy salt. Lucky."},
	{"Cheap as dirt", -2, "Then you've been to a better market than mine."},
	{"It's good, a bit more salt", 4, "Salt! I knew it. Thank you."},
	{"I've had worse", 1, "That's not a compliment, but I'll take it."},
	{"It's pig swill", -4, "Then eat the pig's share and leave mine."},
	{"For a few weeks, yes", 3, "Weeks is all it needs. Good eye."},
	{"I know nothing of wood", 0, "Then you're safe from my questions."},
	{"Green wood is worthless", -2, "Worthless is a hard word for wood that's just wet and unreliable."},
	{"Coin, it spends anywhere", 3, "Spoken like a carpenter."},
	{"Ale, it's warm in the belly", 0, "Everyone says so until the rent is due."},
	{"Neither, I'd work for free", -2, "A fool works for free. A saint, perhaps."},
	{"Court early, life is short", 2, "Exactly what I think."},
	{"Wait until he has a trade", 3, "I've a trade! Father, you hear that?"},
	{"Don't, women are trouble", -3, "Then I'm glad you're not my father."},
	{"Yes, and it never leaves you", 4, "No, it doesn't. Thank you for saying so."},
	{"Not yet", 1, "Then be glad of that. It's hard."},
	{"Everyone dies, it's nothing", -4, "Leave this table if you can't hold your tongue."},
	{"I'll look in the forest", 4, "Mind the forester. Tell him I sent you."},
	{"I can't tell a good beam", 0, "Nor could my son, evidently."},
	{"Use a worse beam, nobody notices", -4, "I'd notice. The chapel would fall on the priest."},
	{"Not at all, it's honest work", 3, "Good. A man who eats sawdust doesn't complain."},
	{"I'd rather not", 0, "Nobody would. It comes with the trade."},
	{"Disgusting, clean your house", -3, "It's a carpenter's house. Of course it's dusty."},
	{"I'll find some for you", 4, "A handful is enough. Good man."},
	{"Perhaps next week", 1, "Next week's a long way off. Thanks anyway."},
	{"I'm no smith", -2, "No. Nor are we. That's why we ask."},
	{"Never, it's a fool's game", 3, "Wise. Tell that to my son."},
	{"Sometimes, for pennies", 0, "Pennies leave the purse as easily as pounds."},
	{"Often, I win a lot", -3, "Everyone wins a lot in the telling."},
	{"The count's, it's his wood", 0, "Law is law. I don't have to like it."},
	{"The finder's, he did the labour", 3, "My thinking exactly. You've a good heart."},
	{"Whoever hides it best", -2, "That's what I'd do. I wouldn't say it aloud, though."},
	{"Ask for coin when they sit", 3, "Rude but wise. I'll try it."},
	{"Lock the door", 0, "Then they'd climb out the window."},
	{"Keep their boots as a deposit", -1, "Their boots! Half of them wouldn't miss them."},
	{"No, I'd say it's sour", 3, "Honest, at least. I'll tell the brewer."},
	{"If it's cheap, yes", 0, "Cheap I can work with."},
	{"I'd praise it loudly", -1, "A fine liar. Come and work for me."},
	{"Yes, an inn keeps its guests' secrets", 4, "That's what Mother says. Thank you."},
	{"I can't say", 0, "I don't know either. I think so."},
	{"No, always obey guards", -3, "Oh. Then I've done wrong. Father will be cross."},
	{"He thinks he's cleverer", 3, "Yes! That's it exactly."},
	{"He likes the company", 1, "Perhaps. Or the free round."},
	{"He's a fool", -1, "A fool with a full purse. We love him."},
	{"No, warmth first", 3, "Quite right. Did you hear that, Bohus?"},
	{"For a very good ale", 1, "Our ale isn't that good."},
	{"Gladly, cold keeps me awake", -1, "Then you'd be here till morning. A fine customer."},
	{"At the river, I can fetch some", 5, "Fetch two and I'll pay. You'll save my kitchen."},
	{"Ask the monks", 1, "The monks sell nothing on a fast day."},
	{"Eat bread and nothing", -2, "Customers want fish. Bread won't fill the taproom."},
	{"Yes, they need a kind word", 4, "You're a good soul. Eat more."},
	{"Some, but they drink too much", 1, "Maybe. But they pay."},
	{"None, they bring it on themselves", -3, "That's a cold thing to say in a warm house."},
	{"Ale, everyone can afford it", 3, "Just what I think. Wine is for show."},
	{"Wine, it's dear and fine", 1, "Dear, yes. Folk don't ask for it."},
	{"Water, it's free", -2, "We'd close by Easter if I sold water."},
	{"I can bring some from the market", 4, "Three would be plenty. I'll pay you well."},
	{"Make your own", 1, "Takes weeks. We've no time."},
	{"Sit in the dark", -2, "They'd drink more in the dark. Then they wouldn't pay."},
	{"It's a nuisance, everyone says so", 2, "Everyone is right. But it won't move."},
	{"Nothing at all", 0, "Then you're lucky."},
	{"I never pay any toll", -2, "You walk round it? You'll be caught."},
	{"Too cold, too fast a fire", 3, "That's just what Father says. You listen well."},
	{"Wet clay, as he says", 1, "We know that much already. Have you nothing better?"},
	{"Bad luck and an evil eye", -2, "An eye! I'd like to find it."},
	{"No, you'll manage", 3, "I'll manage. Slowly."},
	{"It's a lot, but doable", 2, "A lot, yes. Thank you for saying it plainly."},
	{"Far too much, you'll fail", -3, "Fail? I haven't failed a mug yet. Not completely."},
	{"Past the bend, as you said", 2, "You listen. Good."},
	{"Not at all", 0, "Pity. I'd have paid for the news."},
	{"Only dirt, you've dug it out", -2, "Dirt! It's the best clay for ten miles."},
	{"I stop, a tired hand spoils the work", 3, "Hear that, Petr? A sensible guest."},
	{"I work till I drop", 0, "Then the work ends when you fall over."},
	{"I never tire", -2, "Then you're not human, or you're lying."},
	{"I could ask around", 3, "Ask quietly. The priest dislikes it."},
	{"No, I'm sorry", 1, "Never mind. We'll manage with ash."},
	{"Lead is poison, forget it", -2, "Poison! My mother used it for years. Mind your mouth."},
	{"Yes, I'll fetch two baskets", 5, "Thank you. Father will be pleased."},
	{"I'll ask the burner", 1, "He's hard to find, that man. Still, ask him."},
	{"No, charcoal is filthy", -2, "Filthy, yes. So is the whole kiln."},
	{"Keep them, a house needs cats", 3, "Father only wants the grey kitten. I'd keep them all."},
	{"Give them to neighbours", 2, "Good idea. The crofter's children would love them."},
	{"Drown them as your father says", -3, "I can't do that! I won't."},
	{"Never, it's honest food", 3, "Spoken like a man who's eaten it."},
	{"Sometimes, I long for meat", 1, "Meat. I remember it."},
	{"Always, pottage is slop", -3, "Slop it may be, but it's ours."},
	{"Yes, it knows the work", 4, "Aye. A tool you've used for years knows your hands."},
	{"It depends on the tool", 1, "A practical answer."},
	{"No, new is better", -2, "New is better until it breaks."},
	{"Yes, you seem clever", 4, "You hear, Father? The guest says so."},
	{"Maybe, with practice", 1, "Practice. That's all anyone tells me."},
	{"No, you're too young", -3, "I'm twelve! That's not young."},
	{"Yes, warm mash and patience helped", 4, "That's what Magda says. Good."},
	{"No, I know nothing of cows", 0, "Then you're no use. But welcome."},
	{"Cull her, she's useless", -3, "Cull a cow? I'd sooner cull a neighbour."},
	{"Fires and dogs at night", 4, "Dogs we have. Fires we'll try."},
	{"Pray and hope", 1, "We do that already. We watch as well."},
	{"Wolves are harmless", -3, "You've never lost a lamb, then."},
	{"Yes, it's lovely", 3, "I knew it! Everyone should have a calf."},
	{"No, never", 1, "Then you must! Come and meet him after dinner."},
	{"Calves are smelly and stupid", -3, "He's not stupid! He's my friend."},
	{"Hide a wheel in the loft", 0, "We tried that. He looked in the loft."},
	{"Share it with a neighbour", 3, "That's sensible. The neighbour's store is safe."},
	{"Tell the count's men to go away", -4, "Then we'd lose the cow and the roof."},
	{"Yes, three sacks", 5, "God bless you. The cows will be glad of it too."},
	{"I'll try", 1, "Then try soon. The hay is running low."},
	{"Oats are dear, I can't", -1, "Neither can we. That's the trouble."},
	{"Yes, it's the least we can do", 4, "You have a kind heart. Eat more."},
	{"Sometimes, when I'm near", 1, "Sometimes will do. Better than never."},
	{"No, the old are a burden", -4, "Hush! We'll be old some day."},
	{"Tie her short", 3, "Tied she is. She screams about it."},
	{"Put thorns on the edge", 2, "Thorns! Clever. I'll try it."},
	{"Eat the goat", -1, "I'd like to. The children wouldn't forgive me."},
	{"Yes, the stars are wonderful", 3, "They are. A man sees a lot when he's quiet."},
	{"Only in summer", 1, "Fair. Winter is for beds."},
	{"Never, I hate bugs", -2, "Bugs are the herdsman's friends. They keep him awake."},
	{"Yes, every creature", 4, "So do I. That's well said."},
	{"I don't know", 1, "Neither do I, but I hope."},
	{"No, cattle have no souls", -2, "That may be. But they have milk."},
	{"Often, and it's a poor wage", 3, "It is. You've been paid that way too, then."},
	{"Never, I'm lucky", 0, "Lucky man. We're not."},
	{"Promises are better than coin", -3, "Mad words. Eat your bread."},
	{"A drum of pans and a calm voice", 3, "Just so. Even a stranger knows it."},
	{"I run from bees", 0, "Sensible. Leave the catching to us."},
	{"Burn the hive", -4, "Burn our bees? They feed us, you fool."},
	{"Yes, who'd know", 1, "Well, you're honest at least."},
	{"No, only from clean fruit", 3, "You'd please me. Though it costs more."},
	{"I'd drink anything", -1, "You'll be easy to feed, then."},
	{"I'm single, still looking", 2, "Then look kindly. It lasts."},
	{"A long marriage, God willing", 4, "God willing. Forty years taught me a good deal."},
	{"I want no wife", -1, "Then you'll eat alone. That's a hard table."},
	{"Eggs, she gives them every day", 3, "Yes, until she grows old."},
	{"The pot, once she stops", 1, "That's practical. Same as I'd say."},
	{"Neither, hens are noisy", -2, "Noisy, aye, but they earn their feed."},
	{"I'll bring a cake", 4, "You're a kind young one. Six pfennig for you."},
	{"I'll try", 1, "Well, try. We'll keep scraping the jars meanwhile."},
	{"Seal them with mud", -2, "Mud! The cider would taste of earth."},
	{"A loss, mostly", 2, "Mostly. You know orchards."},
	{"It thins the fruit, which helps", 3, "It does! You have good sense."},
	{"I like frost, it's pretty", -2, "Pretty, perhaps. Not when it eats the apples."},
	{"Politely, once", 3, "That's the plan. Politely and from a distance."},
	{"Never, I'd bear it", 0, "A peaceful soul. I'd like to be."},
	{"Loudly, with a stick", -3, "I'd be a smear on the road."},
	{"Warm cloth and rest", 3, "We do. But hearing it is good."},
	{"Herbs in warm water", 3, "Herbs. The herb widow has them."},
	{"Cut your legs off", -3, "What a dreadful thing to say."},
	{"Yes, it's a fair trade", 3, "I think so too. Vaclav won't agree."},
	{"Ask for coin too", 2, "Coin and a jug. That's more like it."},
	{"Never, apples are gold", -2, "Gold! Perhaps. But we have so many."},
	{"A dog, he sleeps at the door", 2, "A good keeper. Better than a lock."},
	{"No, only my own two feet", 0, "Travelling light. I envy you that."},
	{"Animals are dirty things", -3, "Dirty or not, they're part of the family."},
	{"Once, it was terrible", 3, "Then you know why I worry."},
	{"No, I've been lucky", 0, "Pray to keep it so."},
	{"Many, and I laughed", -4, "Laughed! A wall coming down usually kills someone."},
	{"No, only coin", 3, "Quite right. I'd bake no bread from promises."},
	{"Only with a seal", 1, "A seal helps. But seals can be forgotten."},
	{"Yes, they're honourable", -2, "You're the first to say it."},
	{"Yes, if the master allows", 4, "He won't. But thank you."},
	{"Not yet, keep learning", 1, "He says that. You both say that."},
	{"No, you're hopeless", -4, "Then I'll show you all. Wait and see."},
	{"A little, I'd shake it out", 2, "A sensible guest. Take a cloth."},
	{"Not at all, I'm used to it", 1, "Used to it! Lucky man."},
	{"I won't eat dusty bread", -3, "Then you'll go hungry. I've no other."},
	{"In the hills beyond the river", 3, "I'll note it. Thank you."},
	{"I've no idea", 0, "Nor do I. That's the trouble."},
	{"Dig up the road", -2, "The road is the count's. That would be a hanging."},
	{"I'll bring four", 5, "Good. I'll pay fair, as I said."},
	{"I can try", 1, "Try quickly. We've no week to spare."},
	{"Stone is heavy, I refuse", -2, "Heavy it is. That's why we pay."},
	{"Yes, it's for God", 4, "Kind. It'll count in heaven."},
	{"Only for a few coins", 1, "A fair answer. We need coin."},
	{"No, God can pay", -3, "God doesn't pay masons. Folk do, or the work stops."},
	{"Always, it's the price of work", 3, "It does. You know what work is."},
	{"Not at all, I'm young", 1, "Wait twenty years and see."},
	{"I never labour", -3, "A fine life. But not an honest one."},
	{"One who teaches and listens", 4, "You flatter me. I like it anyway."},
	{"One who pays well", 2, "Pays well, aye. That counts."},
	{"One who's never present", -3, "That is no master at all."},
	{"Yes, it builds his pride", 3, "Pride and skill. A fine mix."},
	{"Only under watch", 2, "Dietrich agrees. Let it be."},
	{"Never, it's the master's", -2, "Old rules. They keep the trade."},
	{"No, nobody at all", 1, "Nobody? Then they hide well."},
	{"A man with a cart, last night", 4, "A cart! Where? Tell me quickly."},
	{"A dozen armed men", -2, "A dozen! I'll not walk there tonight."},
	{"Cold water on the face", 3, "Tried that. It doesn't last."},
	{"A friend to talk to", 4, "Talk, aye. That might keep me up."},
	{"He can't, give up", -2, "I'd give up the clamp, but the bread would stop."},
	{"Once, I ran", 2, "Running was the clever thing. Good for you."},
	{"Never, I'd rather not", 1, "Then keep it that way."},
	{"Often, I slew three", -3, "Three! With what, a spoon?"},
	{"Much better", 2, "A sausage is a wonder."},
	{"About the same", 0, "The same? You've odd taste, stranger."},
	{"Bread is superior", -1, "Then you'll not have my share."},
	{"Yes, two good ones", 5, "That's good of you, stranger. Thank you."},
	{"I can ask in the village", 1, "Ask the cooper. He's got a bit."},
	{"No, ropes are dear", -2, "They are. That's why I'm paying you to fetch them."},
	{"Yes, with straw and patience", 3, "Straw we have. Patience, not so much."},
	{"No, I'm no builder", 0, "Nor are we. That's why it leaks."},
	{"Burn it and start fresh", -3, "Burn it! I'd burn you first."},
	{"No, it's theft", 0, "By the law, yes. You're right."},
	{"Yes, when it's cold and hungry", 3, "The law says no, but I've been cold. I'd cut."},
	{"Always, trees are free", -3, "The count would hang you for that."},
	{"Yes, I'll bring six bundles", 5, "Good. You're a better man than my brother."},
	{"I'll ask the children", 1, "The children? I couldn't say if they'd do it."},
	{"Gather it yourself", -2, "I would, if my back let me."},
	{"Yes, they sound near", 3, "Then it's true. Keep the fire high."},
	{"Only owls", 1, "Owls. Then you're on my side."},
	{"I fear no wolf", -2, "Then you've never met them. Wolves don't mind brave men."},
	{"Yes, we quarrel often", 3, "Brothers should. It keeps them near."},
	{"No, I'm alone", 1, "Alone? I'd miss mine, snoring and all."},
	{"I hate my brother", -3, "That's a sad thing to say at table."},
	{"Yes, half before the cloth", 3, "That's what I've said for years."},
	{"No, trust is better", 1, "Trust is nice. It won't buy thread."},
	{"Never, always pay at the end", -1, "Perhaps. But I'm no merchant."},
	{"Ash and sand", 2, "Sand scours well. Thanks."},
	{"Wear gloves", 3, "Gloves. Fine, we'll make some."},
	{"Wear them proudly", 0, "I will. But they still itch."},
	{"No, she's young", 4, "Just so. Matous says the same."},
	{"A little, she must learn", 1, "A little. I'll try."},
	{"Yes, harshly", -3, "Harshly? Not in my house. Mind yourself."},
	{"No, thank God", 2, "Thank God indeed. I've found three in the bread."},
	{"Once, as a child", 1, "And lived? Then you're hardy."},
	{"Many, I find them tasty", -3, "Odd. You'd better leave."},
	{"Yes, two good lengths", 5, "You'll have my thanks and twelve pfennig."},
	{"I'll ask the weaver", 2, "That's fair. Say the tailor sent you."},
	{"Linen's the weaver's, not mine", -1, "True, but you could carry it."},
	{"Blue, as always", 3, "Blue! My hands agree."},
	{"Green, like spring", 2, "Green, like spring. I'd wear that."},
	{"Brown, the colour of dirt", -2, "Dirt it is. Good for hiding."},
	{"Yes, he blesses the shop", 3, "He does. And forgives the debts."},
	{"No, he pays like anyone", 2, "That's fair."},
	{"He should pay double", -2, "That's cruel. I like it anyway."},
	{"A joy, a skill is a gift", 3, "Well said. Thank you."},
	{"A burden, but it pays", 1, "That's it. A burden that pays."},
	{"Torture, give it up", -2, "Then what should we eat?"},
	{"Yes, I'm handy", 3, "A rare man. You could be a tailor."},
	{"I pay somebody", 1, "A good customer, then."},
	{"Never, I wear them out", -2, "What a waste. Most coats could be saved with a few stitches."},
	{"No, be fair", 4, "Good man. A fair price leaves both sides fed."},
	{"Everyone haggles", 1, "True enough. Everyone does it."},
	{"Haggle hard, they cheat", -3, "Cheating is for tailors, not their customers."},
	{"Pay more, I need it", 2, "That's the answer I wanted. Folk always need salt."},
	{"Walk, a day is cheaper than a pfennig", 1, "A thrifty one, then. I can't fault that."},
	{"Steal it", -4, "Thieves don't sit at my table, stranger."},
	{"Only after weighing it myself", 4, "Hear that, Father? A guest with sense."},
	{"If the price is good", 1, "A good price usually hides a light scale."},
	{"Gladly, I trust everyone", -3, "That's how fools lose purses."},
	{"Yes, if the boy's honest", 3, "I'd say so too. But Hedvika is a proud woman."},
	{"No, it starts rumours", 2, "It does. Albrecht, think on that."},
	{"Never, ribbons are bribes", -2, "Bribes! He's fourteen."},
	{"Send the bill, politely, again", 4, "Politely, yes. We've sent the bill twelve times already."},
	{"Stop selling to him", 2, "Bold. But he's our best custom."},
	{"Rob his cart", -5, "Madness, stranger! Out of my house."},
	{"Yes, you've good hands", 3, "See, Father? The guest says I've good hands."},
	{"Prove it by test", 1, "Yes, test me! I'll get them all right."},
	{"No, you're a boy", -2, "I'm not! I'm fourteen and a half."},
	{"In my head, mostly", 1, "Dangerous. A head forgets."},
	{"I scratch them on a stick", 3, "A tally stick. Honest and cheap."},
	{"I never count", -2, "Then you're poor or reckless."},
	{"Yes, a good smile helps", 3, "See, Mother? I said so!"},
	{"Only if the price is fair", 2, "I'd charge a fair price, always."},
	{"No, women should be at home", -3, "Then you'll miss the best ribbons in town."},
	{"Yes, they show respect", 3, "Quite right. Konrad, did you hear?"},
	{"Not always, a poor man may have them", 2, "A fair point, kindly put."},
	{"Manners are for fools", -3, "You eat at a merchant's table. Mind it."},
	{"Peace and a full table", 3, "Simple wishes. I can't argue with those."},
	{"A fur collar", 1, "A fur collar? Elsa will like you."},
	{"A merchant's purse", -1, "We all do. But it's greedy."},
	{"Yes, travellers were robbed", 4, "Then I was right. Konrad, hear that."},
	{"Only rumour", 1, "Rumour. That's what Konrad says too."},
	{"None, the roads are safe", -2, "You've been lucky, or you are one."},
	{"Perhaps, I've heard it said", 3, "Heard it said, you see? I'm right."},
	{"No, they're just as good", 2, "Then we disagree. Pleasant."},
	{"Today's barrels are useless", -3, "Not useless! My son makes them."},
	{"You, the hoops are fine", 1, "There, father. The hoops are fine."},
	{"Both, an old eye and a young hand", 3, "A diplomat. Take more bread."},
	{"Your father, I see the light", -2, "Traitor! Eat quickly and go."},
	{"Yes, six of them", 5, "God bless you. The brewer will drink to you."},
	{"I can find a few", 2, "A few is enough to start."},
	{"I'm no woodworker", -1, "No. But you could carry."},
	{"Thyme in hot water", 4, "The widow has thyme. Thank you."},
	{"Honey and warm milk", 3, "A good idea. Father, drink that."},
	{"Rub him with snow", -3, "Snow! You'd kill him."},
	{"Yes, a bit sharp but drinkable", 2, "Drinkable! High praise from a stranger."},
	{"No, I never drink ale", 0, "A rare virtue. Or a lie."},
	{"It's the worst I've had", -1, "Then we agree. Do you have a barrel for it?"},
	{"Yes, it fits the sitter", 3, "You've sense! My son has none."},
	{"Mend it with a new leg", 2, "A new leg. Hm. Not a bad thought."},
	{"No, burn it", -3, "Burn it! I'd burn you first."},
	{"Small, they fit a cart", 3, "They do! The merchant will say so."},
	{"Big, they last", 2, "Father will like you."},
	{"Neither, drink from the jar", -1, "Not a bad thought, that."},
	{"No, but I'd like to hear your tale", 4, "There! Martin, a listener at last."},
	{"Once, a bishop", 1, "A bishop! He likely paid in blessings."},
	{"I serve no one", -2, "Proud talk. Even you drink from somebody's barrel."},
	{"Yes, two bunches", 5, "Good. Take four pfennig."},
	{"I'll try", 2, "Try and I'll pray."},
	{"Herbs are weeds", -2, "They're weeds that cure."},
	{"A father, he cares", 3, "You're kind to say it."},
	{"A master, he teaches properly", 1, "A hard master, yes. That makes a good cooper."},
	{"Neither, learn alone", -2, "Then you'd cut your hand off."},
	{"Sweet, it's easy on the tongue", 2, "Sweet. I'll try for the next barrel."},
	{"Sharp, it wakes a man", 3, "Good taste. You'll do."},
	{"Neither, I drink water", -3, "Water, is it? We've no use for you here."},
	{"Only a very weak one", 2, "That's what we give ours. Weak small beer."},
	{"Never, they're too young", 3, "Right. Water or milk."},
	{"Yes, it's good for them", -3, "Not in this house. Hana is only eight."},
	{"Yes, two sacks", 5, "Good. You'll drink free tonight."},
	{"I'll ask the farmers", 2, "Ask kindly, and they might sell."},
	{"Barley is for fools", -2, "No barley, no ale. Who's the fool now?"},
	{"Gladly, may it be sweet", 4, "That's a proper toast. Cheers."},
	{"A sip only", 1, "A sip will do."},
	{"Not if it's sour", -2, "It's a barrel either way. Take a sip."},
	{"Yes, two bundles", 5, "You're a help. Take eight pfennig."},
	{"I'll ask the farmers", 2, "They may have some."},
	{"Hops are weeds", -2, "Weeds, is it? Weeds that bring in good coin."},
	{"Yes, it lasted three days", 3, "Three days is the proper length."},
	{"Not for years", 1, "Then it's overdue."},
	{"I hate weddings", -2, "What a sour answer. Take a drink."},
	{"Ale, it fills a man", 3, "Ale it is, then. A friend at last."},
	{"Cider, it's sweet", 1, "I won't argue. I'll drink both."},
	{"Wine, the rest is slop", -2, "Slop? In my own house?"},
	{"Warm, in winter", 3, "Mulled, then. I like that idea."},
	{"Cold, always", 1, "Brave. And frozen."},
	{"Hot, like soup", -1, "Hot as soup? We've tried it."},
	{"Gladly, with a mug", 3, "Now that's a guest."},
	{"I'll carry it to the inn", 2, "The innkeeper won't pay full price."},
	{"Pour it in the stream", -3, "Pour good ale in the stream? I'd cry for a week."},
	{"Hana has the sharper nose", 3, "That's true. Jana's chin is rounder."},
	{"No, you're identical", 1, "We are. That's half the fun."},
	{"They are both wild", -1, "Wild but dear. Eat."},
	{"No, work is work", 3, "That's sense. I'll tell the steward so."},
	{"Yes, to keep him happy", 0, "That's safe. It's also poor business."},
	{"Yes, then rob him", -4, "Out of my house with that talk."},
	{"Bad iron, a poor smith can't fix it", 1, "The master won't agree, but thanks."},
	{"A bit of both, learn from it", 4, "Yes. Both. I'll watch the quench next time."},
	{"You're no smith at all", -4, "Oh. Well. At least you said it straight."},
	{"Honey and cold water", 4, "I've a little honey. Thank you."},
	{"Butter and linen", 2, "Butter, hm. I'll try it."},
	{"Spit on it", -2, "Spit on a burn? Filthy habit."},
	{"No, it's dangerous", 3, "Thank you. Vojtech, you heard the guest."},
	{"Only quietly, to friends", 2, "Quietly. Yes."},
	{"Yes, loudly, at the market", -3, "You'd have him hanged by Sunday."},
	{"Yes, three baskets", 5, "Good. I'll pay you fair."},
	{"I'll ask the burner", 2, "He's near the clamp. Go early."},
	{"Charcoal's filthy", -2, "So's the forge. So's the smith."},
	{"Yes, two bars", 5, "Thank you! The master will be calmer."},
	{"I'll try the merchant", 2, "The merchant's dear. Try him anyway."},
	{"I'm not your servant", -2, "Sorry. I'll find another way."},
	{"Fire, it's alive", 3, "Aye, alive! That's it."},
	{"Iron, it lasts", 2, "Iron, yes. It'll be here after us."},
	{"Neither, I'm afraid of both", -2, "Afraid of fire? A smith would weep to hear it."},
	{"Yes, it earns him pride", 4, "Thank you! I'll make a fine one."},
	{"Only when the master allows", 2, "He allows. Eventually."},
	{"No, only the master's mark matters", -2, "Maybe. I'd still like my own."},
	{"Yes, it hurt", 3, "It's the worst. A brute of an animal."},
	{"No, I fear horses", 1, "Wise. They're all teeth and hooves."},
	{"I kick back", -2, "A horse would laugh at that."},
	{"Yes, goodwill matters", 4, "Thank you! Did you hear that, Vojtech?"},
	{"Not for free", 1, "Then pay us. We'll think."},
	{"Never, the neighbour should move", -3, "Hush! The smith agrees, and that's trouble."},
	{"Tie her short and give her a bone to chew", 3, "A bone! Ida, hear that? Still, a short rope is a good thought. We'll try it."},
	{"A stout hurdle, set deep", 2, "Deep, yes. Prokop dug it like a man digging his own grave, and she got through anyway."},
	{"Eat the goat", -3, "Eat her! She gives us milk, guest. We'd sooner eat the shoes she chewed."},
	{"The carpenters in this village might, for a few turnips", 4, "Kolar, aye. He might take turnips, or a day of my back for it. I'll ask."},
	{"I can look at it myself, if you like", 5, "You'd climb up there for us? That's kind. Mind the third beam, it's soft."},
	{"A roof's no concern of mine", -2, "No. Dry folk never think of it."},
	{"Both, and I'm sorry for it", 3, "Thank you. Nobody here is sorry. Mother only says I should watch my feet."},
	{"Maybe you fed her the shoes yourself", -1, "I didn't! Well, once I fed her a bit of lace. That was different."},
	{"I once lost a boot to a dog", 2, "A dog! Adam, a dog! Goats aren't the only ones. Hear that, mother?"},
	{"A kind woman. I'll say a prayer for her too", 4, "Do. We can't repay her with anything but prayer."},
	{"I know her. She counts every candle she gives", 0, "Perhaps. But she gave us two, and counted them with a smile."},
	{"Why would a rich woman give to the poor?", -2, "Because God told her to, and she listened."},
	{"Here, take a few pfennig. Pay me when you can", 5, "Bless you. At harvest I'll pay you in turnips. I mean that."},
	{"I've little coin, but I'll bring you seed if I find some", 3, "That's honest of you. Seed's worth more to us than coin."},
	{"A man should save before he sows", -3, "Save? With what, guest? Five mouths and one strip."},
	{"The stars. Can you count them?", 3, "Yes! Well, no. They move when I count. I'll try again tonight."},
	{"Pfennig, if I give you some", 2, "One, two, three! Mother, he gave me three!"},
	{"Nothing's bigger than four in this house", -2, "That's rude, but it's nearly true."},
	{"Tracks near the ridge. Keep the goat close", 4, "Then I was right. Ruzena, bring the goat in. Thank you, guest."},
	{"No, but I wasn't looking", 0, "Then look next time. The wolf will be looking at you."},
	{"Wolves don't come near houses", -2, "They do in a hard winter, and this is one. You're no farmer, I'd say."},
	{"A year when the barns burst, and everyone sang", 3, "I'd like to see that. We'll sing for nine sheaves, if it comes to it."},
	{"I've seen none, only thin years", 1, "Thin years are what we know. There's pottage if you want it."},
	{"Every farmer says his father had a better year", -2, "Does he? Well, that's fair. The pottage is cooling."},
	{"Gladly. Bless this house and all in it", 5, "Amen. That was kindly said. Sit, sit."},
	{"I'll sit quietly and listen", 1, "That's fine. God hears the quiet ones too."},
	{"I pray when it suits me", -3, "That's no way to pray, guest. Pass the bread."},
	{"Yes. Tell me which strip", 5, "That's good of you. The far one, by the big stone. I'll bring water."},
	{"Maybe tomorrow, if my legs allow", 1, "The weather may turn by tomorrow. I'll hope for you anyway."},
	{"I'm no harvest hand", -2, "Then eat and rest. I'll manage the rye myself, somehow."},
	{"The cobbler or the tanner may have scraps", 4, "Scraps, of course. I'd never have thought to ask. Thank you."},
	{"I'll look for a pair on my travels", 5, "You'd do that? God see it written. Ida, say thank you."},
	{"Poor people always want something", -4, "We do. Shoes, for the children. It's not much to ask."},
	{"Gladly. Green hides mud", 4, "Mud! Alzbeta, he says green hides mud. We'll sell it that way."},
	{"I'd sooner have blue", 0, "Everyone would. Blue costs more than the cloak."},
	{"Green is a fool's colour", -3, "Then half this valley is fools, and they all buy from us."},
	{"For liking. A roof can leak", 3, "A roof can leak, and so can a husband. I'll think on it."},
	{"For a roof. Liking comes later", 1, "That's what mother said. She was right for a time."},
	{"Neither. A woman does well alone", 2, "Hear that, Vendula? A stranger agrees with you."},
	{"The carpenter, Kolar, is just up the lane", 3, "Kolar. Yes, the wheelwright. He'll want a length of cloth for it."},
	{"I could try. I've a hammer", 4, "Then try, but go careful with the warp threads. They're fine as hair."},
	{"Buy a new loom", -2, "With what? Coin grows slower than flax."},
	{"Not at all. A fair trade", 3, "A fair trade. Not many would put it that way."},
	{"I'd hold my nose and say nothing", 0, "That's how the village does it. Holds its nose and curses under its breath."},
	{"It's foul. Move it further off", -2, "Move it where? Every bit of water has someone's cow."},
	{"Gladly. Give me the skein", 5, "Here. Keep it out of the damp. That's kind of you."},
	{"If it's on my way", 1, "It's on the road. Everything's on the road."},
	{"I carry no one's goods but my own", -2, "Then you're a careful man. Eat your cheese."},
	{"A deep red, if you can", 3, "Madder. It costs a little and wears for years."},
	{"Whatever's cheapest", 0, "Grey, then. Or whatever's left in the pot."},
	{"Black, like a monk", -1, "Black's costly and drab. Monks don't pay for it either."},
	{"I know one about a miller. I'll sing it", 4, "Sing, then! Alzbeta, put the wheel down and listen."},
	{"None, I'm afraid", 0, "Then we'll sing for you. Sit by the fire."},
	{"Singing's for tavern folk", -2, "We'll go and sing at the tavern, then. Their ale is better."},
	{"Gladly. A baby shouldn't be cold", 5, "Bless you. It'll be ready after the next full moon."},
	{"I'll carry it if you give me a coin", 0, "A coin? For a gift? Well, a small one."},
	{"The crofters never pay anyone", -4, "They can pay in thanks. That's more than you'd give."},
	{"Gladly. I've the patience", 4, "Patience is rare. Sit. We'll put you by the window."},
	{"If it doesn't take all day", 1, "It takes all day. Well, sit a little then."},
	{"That's women's work", -3, "Women's work, is it? Then you'll eat women's bread and wait."},
	{"For two fish, perhaps", 3, "Two! Vendula, did you hear? A man with a head for bargains."},
	{"No, but I'd eat the fish", 1, "Quite right. The fish deserves better than he does."},
	{"A fish is no reason", -1, "Then what is? A bowl of gold? There's none to be had."},
	{"There's a stand of oaks in the abbey woods", 3, "The abbey's. They'll want a tithe of the timber. Still, it's a start."},
	{"I can look about for you", 4, "Do. And bring me a plank if you can. I'll pay fair."},
	{"Use pine, it's cheap", -2, "Pine splits under a cart. You've never built a wheel, have you?"},
	{"Only if the priest agreed, and said so aloud", 4, "Aloud, yes, that's sensible. I'll ask him, after a drink for courage."},
	{"A bow's a bow. Cut it", -3, "Careful. The priest will hear of it, and the village never lets one thing go."},
	{"I'd ask the saints first", 2, "That's nearer. Which saint, though? One for archers, perhaps."},
	{"Yes. A fair swap beats a long debt", 3, "A fair swap, yes. I'll trade a spoke for a sack of flour."},
	{"No, coin only", 0, "Coin only? Then I'd starve. But I like the sound of it."},
	{"A wheelwright should work for glory", -3, "Glory! Glory doesn't turn a hub, guest."},
	{"Look at who talks first", 3, "The younger one talks first. Kristof, you've been talking to the wrong sister."},
	{"One has blue hands, the other green", 2, "Both have blue hands. That's the problem."},
	{"It's none of my business", 0, "No. But it's a pleasure to hear a man say so."},
	{"Yes. I'll bring a barrow", 5, "Good, a barrow will do. Come at dawn and I'll feed you after."},
	{"I might. Tell me the pay", 1, "A loaf and a coin. That's all we've got."},
	{"The abbey should come itself", -2, "The abbey does as it pleases, guest. We just haul what it orders."},
	{"A little. It's only wood", 3, "Only wood! Hear that? A man who understands us."},
	{"None. It's very fine soup", 4, "Kind of you. Have more, then, and I'll strain the pot."},
	{"It's gritty. Wash the pot", -3, "Wash the pot! I wash it every week. It's the air, I tell you."},
	{"I'll bring some when I pass", 5, "Do. We'll keep a bowl of pottage warm for you."},
	{"The abbey sells it, I think", 1, "They sell dear, but they sell."},
	{"Wood's cheaper in summer", -2, "It is. But it's winter, guest, and we're cold now."},
	{"It is. I waded to the knee", 3, "Knee-deep. That means no carts for a week."},
	{"It's passable, with care", 2, "Passable, is it. I'll send the boy to look anyway."},
	{"I came the high road and saw nothing", 0, "The high road's dry. It's a longer walk, but fair."},
	{"If it's so, yes", 3, "If it's so! It's so, I swear on my mother's grave."},
	{"Show me first", 2, "Fair. I'll show you, if the priest is out."},
	{"Bows are for poachers", -4, "Poachers, is it! My bows are for the duke's own men."},
	{"Always. I'm no different", 1, "Honest, at least."},
	{"Mine was a good one for mending", 3, "Then tell mine to listen."},
	{"A woman should mend her own hinges", -4, "Should she? Then he'll mend his own supper."},
	{"Yes, if the loaf is hot", 2, "Hot, always. But I'd sooner take coin."},
	{"Coin only, if I'm honest", 3, "An honest man. Take two rings, with my blessing."},
	{"Candles are better than bread", -3, "Say that to my belly, guest."},
	{"Gladly. I'll mind them", 4, "Good. Make sure he pays you the coin before you hand them over."},
	{"If I get a pretzel for the road", 2, "One. And you'll count the rest on the way."},
	{"I'd eat half before I got there", -3, "Then you'll not carry for us again."},
	{"Fine and white, but dear", 3, "White, is it. We'd be glad of rye, if only it were dry."},
	{"Much like here, and damp", 1, "Then the weather's to blame. I'll forgive the miller."},
	{"Coarse and full of stones", -2, "Stones! Then the miller there is a thief, too."},
	{"Yes. Tell me where it stacks", 5, "By the back door. God keep you. Mother will cry with joy."},
	{"I might. Is there bread?", 2, "There's always bread. It's the only thing in the house that's warm."},
	{"I've troubles of my own", -2, "Everyone does. At least you said it plainly."},
	{"With a good loaf and a good heart, yes", 4, "A good heart! I've that. The loaf I'll bake tonight."},
	{"Better learn to read first", 1, "That's what mother says. She can't read either."},
	{"The chandler will never allow it", -3, "Never's a long time. But the day's short."},
	{"Gladly. I like a dark crust", 4, "A liar, but a kind one. Sit and eat."},
	{"A little. With butter", 1, "Butter! We've none. But I'll scrape the black off."},
	{"No. Give it to the pigs", -2, "The pigs eat better than we do already."},
	{"Always. Bread is a gift", 4, "It is. God gives the wheat, we only bake it."},
	{"When I remember", 1, "Remember more. It's no hardship."},
	{"Bread is only bread", -3, "Only bread, child? A poor man's whole day goes into a loaf."},
	{"Gladly. I'll watch for it", 4, "God bless you. We'll bake you a ring to carry home."},
	{"I'd need coin first", 0, "Coin we have a little of. Honey we have none."},
	{"Honey is for rich men's tables", -2, "It is. We bake for those tables."},
	{"The Sedlak farm, yes", 3, "Sedlak, is it. Proud, but he sells fair. Thank you."},
	{"I can ask for you on the road", 4, "Do. Tell them the baker pays in bread, and bread keeps."},
	{"Farmers keep it all for themselves", -2, "Some do. I'm sorry you've known them."},
	{"No. I miss him too", 4, "Then you know. Sit, eat. There's a ring left."},
	{"Yes, and he still sings badly", 3, "Then you're lucky. Tell him to keep it up."},
	{"I never knew him", 1, "Then there's an empty spot, too. Eat, child."},
	{"Yes. Children are God's gift", 4, "They are. They're also another mouth to feed."},
	{"It's a hard burden on them", 1, "Hard, yes. But the Lord measures the burden and the shoulder."},
	{"Poor folk should have fewer", -4, "That's a cold thing to say. I'll forget I heard it."},
	{"Both. One helps the body, one the soul", 4, "That's what I say. You've a good head."},
	{"Herbs. Prayer does nothing for a fever", -3, "Child, you've not sat all night with a dying man."},
	{"Prayers. Herbs are old wives' work", -1, "Old wives' work keeps this village alive. Eat your porridge."},
	{"Once. I fainted", 3, "Fainted! That's what they do to folk. Sit, child."},
	{"Never. I'd not allow it", 2, "Wise of you. Keep your blood."},
	{"Yes, and it helped me", -2, "Did it? Perhaps. I'll not quarrel at table."},
	{"Yes. White flowers, flat like a plate?", 5, "That's it! You've an eye. God bless you."},
	{"If I remember", 1, "Remember, child. Someone's blood may depend on it."},
	{"I've no eye for weeds", -2, "Weeds! That's medicine you're sneering at. Eat your bread."},
	{"My mother. I think of her at supper", 4, "Then you know. We'll set a stool for her tonight, in our hearts."},
	{"Nobody I'd speak of", 0, "That's sad, or lucky. I'll not ask."},
	{"The dead are dead. Let them be", -3, "They're not gone while someone remembers them. I set a stool for mine."},
	{"A little. I'd take your thyme gladly", 4, "Then sit nearer the fire. I'll steep some."},
	{"It's nothing", 0, "It's never nothing. I'll make some anyway."},
	{"I don't trust old women's potions", -4, "Then cough, and good luck. Eat."},
	{"Often. A guest's life is lonely", 3, "Then we're two. Sit. We'll talk across the pot."},
	{"No. I always find company", 1, "A gift. Keep it."},
	{"Better alone than with fools", -2, "I'll not take that as meant for me."},
	{"Yes. I'll bring a bag", 5, "Take gloves, child. I never could. God keep you."},
	{"If you tell me which are nettles", 2, "The ones that sting. You'll know."},
	{"Nettles are for pigs", -3, "Pigs live well. Make of that what you will."},
	{"Yes, I'll take it today", 5, "Today? God bless you. Tell him to drink all of it."},
	{"If it's not far", 1, "Not far, an hour at most. Good walk for young legs."},
	{"It's not my errand", -2, "No. But it's someone's father."},
	{"Sometimes. I say a prayer", 4, "Say it louder. The Lord's ear is far, but it hears."},
	{"Never, I sleep like a stone", 1, "Lucky you. I'd give a good deal for that."},
	{"Dreams are only noise", -2, "That's what the young say. They'll learn."},
	{"Gladly. Show me the vat", 5, "Good. Mind the tallow, it burns like sin."},
	{"If the wage is fair", 2, "Two pfennig a dozen. That's fair."},
	{"Candles are women's work", -3, "Candles are my work, and my father's. Mind your tongue."},
	{"A little. You get used to it", 2, "Used to it! That's what father says. I never will."},
	{"It's a good, honest smell", 3, "Honest, aye. Honestly awful."},
	{"It's foul. How can you eat?", -2, "We eat fast and keep the window open."},
	{"If he's kind, yes", 3, "He is kind. And he bakes. A girl could do worse."},
	{"A chandler's daughter should marry up", -2, "Up! Up where? To the duke's court, I suppose."},
	{"I'd ask the priest", 1, "The priest would ask for a candle. I know how this goes."},
	{"The light. A candle that burns is a good one", 3, "Hah! Aye, folk don't pay for the weight, they pay for the light."},
	{"The weight. Honest measures matter", 2, "Honest measures, yes. That's what I tell the reeve."},
	{"Neither. All candles are a cheat", -4, "A cheat! In my own house. You'll not say that twice."},
	{"Gladly. I'll watch for the bees", 4, "God keep you. Two cakes would do us."},
	{"If it's not too heavy", 1, "Light enough, a cake of it. The price is what hurts."},
	{"I'd want half the profit", -3, "Half! The church would laugh. We'll find another."},
	{"Yes, two of them", 5, "Two! God bless you. I'll wrap them in cloth for you."},
	{"One, if the price is fair", 2, "A pfennig. It's fair, and the priest's blessing is free."},
	{"I don't buy for the poor", -4, "Then the poor will have to light their own."},
	{"Yes. A turnip is a good thing", 3, "Kind of you. Then take a candle. We'll keep the worm."},
	{"Only without the worm", 1, "The worm's the best part. It means the turnip is sweet."},
	{"No. Coin or nothing", -2, "Then it's a silver coin for each candle. Take it or leave it."},
	{"A house with seven windows", 3, "Seven, one for every day. I'd like that. Father wouldn't."},
	{"A bridge over the river", 2, "A bridge! I'd take that over a roof."},
	{"Nothing. Building's for fools", -2, "Then who builds the churches? Eat your meat."},
	{"Wicks. They glow at the end", 3, "That's pretty. I'll remember it."},
	{"Wool. It's softer", 1, "It's softer, aye. But it itches."},
	{"Neither. A guest shouldn't work", -1, "Then eat and watch, guest. That's your work here."},
	{"The Sedlak farm slaughters often", 4, "Sedlak. A proud man, but a fair one. Thank you."},
	{"I'll look about for you", 4, "Do that. Three lumps would see us through."},
	{"I don't deal in fat", -2, "No. But you eat it, I'd wager."},
	{"The best. The ale's good and the host's better", 3, "Hear that, Milada? The best! Have a mug, the first is free."},
	{"It's the only one I've seen here", 1, "Honest, at least. The first is still free."},
	{"I've known much better", -3, "Better, is it? Then drink there. We'll keep your stool warm for your return."},
	{"Gladly. I'll be polite", 4, "Polite, aye. If he's drunk, don't be too polite."},
	{"I'd rather not. He's a neighbour", 1, "He is. I'd rather not either. But the ale costs."},
	{"I'll knock him down for you", -4, "That'd lose us a customer, guest. Keep it civil."},
	{"Yes. I'll bring two jugs", 5, "Two jugs, good. The brewer owes me a favour. Mention my name."},
	{"If I'm passing that way", 1, "Everyone's passing, aye. I'll hope anyway."},
	{"Ale is dear. Brew your own", -2, "Brew my own! Then I'd be a brewer. I'm an innkeeper."},
	{"Gladly. I'll sing, even badly", 4, "Bad singers are welcome here. Take a place by the fire."},
	{"I may. If the road allows", 1, "The road will allow. We'll light a torch for you."},
	{"I don't drink with the priest", -3, "Then you'll drink with me. The priest drinks quietly."},
	{"It looks sound. Clear the snow off, though", 4, "Hear that, Otakar? Clear the snow. Someone who knows roofs."},
	{"I couldn't say", 0, "No one can. That's the trouble with roofs."},
	{"It'll collapse by Easter", -3, "Hush! You'll bring bad luck to the house."},
	{"Yes. Two fresh cuts", 4, "Two cuts is plenty. We'll string them over the fire."},
	{"I'd need a day to find some", 1, "A day's fine. We'll manage."},
	{"I'd rather drink than hunt pork", -1, "A man of simple tastes. Sit, then."},
	{"The rain. They'll be here by dawn", 3, "Dawn! They'll be here at midnight, singing."},
	{"They've no coin until the harvest", 2, "True enough. It's a lean season for the Hare and the village."},
	{"Your ale's too dear", -4, "Too dear, is it? It's the cheapest in the county. There's only one, and it's us."},
	{"No, but I kept my eyes open", 3, "Eyes open, good. The road's no place for sleepers."},
	{"I saw two men with a mule near the ford", 2, "A mule! The carter was right. I'll tell the reeve."},
	{"Bandits are a tavern tale", -1, "Tales sell ale. I'll not complain."},
	{"Gladly, and well", 3, "Hah! Then they're all the same. Sit down and have a mug."},
	{"Never in front of me", 1, "Never in front. That's the trick."},
	{"A priest should never touch it", -3, "A priest is a man. We'll leave it at that."},
	{"Gladly. Where's the hammer?", 5, "By the keg. I'll have the ale poured before you finish."},
	{"In the morning, after breakfast", 1, "Morning's fine. I'm in no hurry, but the horses are."},
	{"Hire a carpenter", -2, "I would, if the carpenter paid me in advance."},
	{"Often, and I liked it.", 3, "Then you've good taste. Take another piece."},
	{"Once. It was too oily.", 0, "The oil keeps you warm. You'll learn."},
	{"Fish is for the poor.", -4, "You're eating it right now. Mind your tongue."},
	{"Tell you at once.", 4, "Good. I'd sooner hear it from a guest than a gossip."},
	{"Mind my own business.", 0, "A fair answer. A tiring one, but fair."},
	{"Take a fish myself.", -4, "Then you're no guest of mine."},
	{"Every one of them.", 3, "God sees it. So does the priest."},
	{"When I remember.", 1, "We all forget. The priest never does."},
	{"Fast days are nonsense.", -4, "Not at this table. Say it at the inn if you must."},
	{"If you're quick and patient.", 3, "I'll be quick! I'll be so quick!"},
	{"A pike would bite you.", 1, "Then I'll wear father's glove."},
	{"No, you're far too small.", -3, "I'm not small. I'm nearly big."},
	{"A good one. Show me the net.", 4, "Now that's a guest worth feeding. Come after the meal."},
	{"Only a simple one.", 1, "Simple holds if you pull it tight."},
	{"I've better things to do.", -3, "Everyone has. The net still needs mending."},
	{"They take too much.", 3, "Then you've been there. Sit, sit."},
	{"They grind well enough.", 0, "Well enough, if you don't weigh it after."},
	{"The miller is a good man.", -3, "Is he? Keep that opinion until he weighs yours."},
	{"A hot stone in my cloak.", 3, "Clever. We'll try that tonight."},
	{"I walk fast and say nothing.", 1, "A good plan until you stop walking."},
	{"I take a room at the inn.", -1, "With a purse like that, aye. We use straw."},
	{"For a full pot, yes.", 3, "Now you're talking sense. A full pot is all I ask."},
	{"Not in this cold.", 0, "Nor would I, if the pot weren't empty."},
	{"Never. I'd sooner starve.", -2, "You've never starved, then. Eat your stew."},
	{"The Pater Noster, every night.", 4, "Then you're one of ours. Say it with us."},
	{"Whatever comes to mind.", 1, "God knows what's meant. Still, learn one."},
	{"I don't pray.", -4, "Hush, in front of the little ones."},
	{"It was quiet when I passed.", 3, "God be thanked. I'll sleep better."},
	{"There were men watching it.", 2, "Then it's true. I'll keep the boat in the reeds."},
	{"I'd not cross it alone.", 1, "Nor would I. That's the trouble with the ford."},
	{"Yes, plainly. He caused it.", 4, "At last, a man who sees it. Ask him, would you?"},
	{"It's the flood's fault.", 0, "The flood's not in the manor court, more's the pity."},
	{"A man pays his own losses.", -3, "Then you've never lost a net."},
	{"Eight pfennig at least.", 4, "Hear that, Kilian? Someone who values honest work."},
	{"I couldn't say.", 0, "Nor can the buyer. He just says four."},
	{"Two. They're only eels.", -4, "Only eels! Then you carry them."},
	{"Not at all, thank God.", 1, "Keep it that way. It's a blessing."},
	{"Every winter.", 3, "You'll know how it is, then. Sit close to the fire."},
	{"I've no roof of my own.", 2, "Then you're welcome under ours. Mind the drip."},
	{"As long as the man who made it.", 4, "You'd make a thatcher. Have more bread."},
	{"Ten years if well kept.", 1, "Ten is a fair guess for straw."},
	{"Roofs aren't my trade.", 0, "Nothing's your trade, by the look of your hands."},
	{"No. It crushes the poor.", 4, "Quietly. But yes, yes it does."},
	{"The count must be paid.", -2, "The count isn't the one paying, is he."},
	{"I pay it and say nothing.", 1, "Then you're wiser than me."},
	{"Not if I've a full belly.", 2, "A full belly, then. Thank God for that."},
	{"Always. I hate it.", 3, "We do too. Come closer to the hearth."},
	{"I sleep like the dead.", -1, "A clear conscience, then. Or none at all."},
	{"The cooper's barrels leak.", 3, "Aye, that's the same. Eat up."},
	{"I've never heard one.", 0, "Then you've lived a quiet life."},
	{"My trade is the best trade.", -3, "They all say that, until the pot is empty."},
	{"Honey, it's worth more.", 3, "Sharp. Honey it is."},
	{"Coin, always coin.", 1, "Coin's honest, if there's enough of it."},
	{"Neither. I'd do it free.", -1, "Then you're a saint or a fool."},
	{"Yes, and I miss them.", 3, "Then I'm glad you've sat at our table."},
	{"No, not yet.", 2, "The Lord provides in His time. We're still waiting."},
	{"None, and I'm glad.", -3, "You say that to us? Eat, and say nothing more."},
	{"Every farmer does.", 2, "And every thatcher prays the opposite."},
	{"I take what comes.", 1, "A calm answer. I like it."},
	{"Prayers don't move clouds.", -3, "Don't say that where the priest might hear."},
	{"For the right price.", 2, "There's no such price. But I've done it."},
	{"Never. It's too dangerous.", 2, "Wise. I'd say the same if I'd a choice."},
	{"Ladders don't frighten me.", -1, "They should. A fall in winter is the end."},
	{"Honey and warm milk.", 3, "We'll try it. The Medars owe us a jar."},
	{"Herbs from the widow.", 3, "Then I'll send him. Does she charge much?"},
	{"Time, and prayer.", 1, "Prayer's free, at least."},
	{"I can mend most things.", 4, "Then the widow's shutter has met its master."},
	{"A little.", 1, "A little is more than none."},
	{"I'd rather not work.", -3, "A guest who won't lift a finger. I see."},
	{"Smoked, every time.", 3, "Good taste. Silvestr, cut a slice for our guest."},
	{"Salted keeps longer.", 2, "True. It costs us in salt, mind."},
	{"I prefer it fresh.", -1, "Fresh is for the rich. We sell it before it sours."},
	{"Trade for it with honest goods.", 3, "Now that's a trader's answer."},
	{"Find a cheaper road to it.", 2, "If you find one, tell me the name of it."},
	{"Do without. Meat spoils anyway.", -3, "You'd lose more than you'd save."},
	{"Gladly. I like both.", 3, "Rupert, you've a friend here."},
	{"Only if the fish is fresh.", 1, "Nothing at Rybar's is ever fresh enough for a butcher."},
	{"I'd keep the sausage.", -1, "Greedy! Well, so would we."},
	{"Not without leave.", 3, "Honest. You'd keep out of the stocks."},
	{"If I were hungry, yes.", 1, "A hungry man's law, that."},
	{"A boar belongs to who kills it.", -2, "Say that to the forester, not to me."},
	{"Yes, and I love it.", 3, "You've a good stomach. Have the end piece."},
	{"Not yet. I'll try.", 2, "A brave guest. It's better than it looks."},
	{"It sounds disgusting.", -3, "Leave it for Silvestr. He's not choosy."},
	{"For liking, always.", 2, "Liba nodded at that. Mind her."},
	{"For money. It's safer.", 1, "Safer, yes. I did the same."},
	{"I'd not marry.", -2, "Then who feeds you when you're old?"},
	{"Anything where I stand all day.", 3, "Aye. Feet remember."},
	{"Mine's easy. I'm a wanderer.", 0, "Walk a mile in my apron, then."},
	{"None. I don't work.", -3, "Then you're the finest guest I've ever fed."},
	{"Not without the work.", 3, "Hear that, master? The work."},
	{"If he's clever, yes.", 1, "I'm clever. It's the trust I lack."},
	{"Never. It takes a lifetime.", -1, "A lifetime, aye. That's all I wanted to hear."},
	{"Salt and a cold cellar.", 3, "A sensible head! Silvestr, write that down."},
	{"I eat it that day.", 2, "Wasteful, but safe."},
	{"I don't. I take my chances.", -2, "Then no wonder you're thin."},
	{"A rich man's sport.", 2, "True. A poor man calls it poaching."},
	{"I like it well.", 1, "Then keep it far from my pigs."},
	{"It's cruel.", -2, "So is the butcher. Eat your stew."},
	{"Hot pottage and bread.", 2, "Plain food, and it fills you."},
	{"Anything warm will do.", 1, "Warm is all anyone wants on a night like this."},
	{"Meat, and plenty of it.", 3, "Then you're a Reznik born."},
	{"Not at all.", 4, "Liar, but a kind one. Eat up."},
	{"A little, but I'll bear it.", 2, "Fair enough. We bear it too."},
	{"Terribly. I can't eat.", -3, "Then go hungry. We've tanned worse."},
	{"If you showed me how.", 3, "Tomorrow, then. It's good work."},
	{"Only for a better wage.", 0, "A better wage? Not from us."},
	{"I'd not touch it.", -2, "Then you'll not wear the shoes it makes."},
	{"No. All stand equal before God.", 5, "Thank you. That's all we ask."},
	{"The priest knows best.", -1, "Does he. Does he really."},
	{"It's the smell, not the trade.", 0, "The smell comes with the trade. They're one."},
	{"Yes, and it still hurts.", 4, "It does. It never goes, it just wears down."},
	{"Not yet, thank God.", 1, "God keep them. Be glad."},
	{"It's none of your business.", -3, "Aye. It's none of mine either."},
	{"A tanner's leather speaks for itself.", 4, "Ha! Take the second helping."},
	{"The cobbler in Talmberg.", 0, "He cuts what we tan. Remember that."},
	{"Wooden clogs beat leather.", -3, "You'd walk in clogs? Then eat your supper in the yard."},
	{"Gladly. I'm not fussy.", 4, "Then you're the first. Drink with us."},
	{"Perhaps, if he washed first.", 1, "A fair demand. We do wash. Eventually."},
	{"No. The smell would sicken me.", -4, "Then keep to your own bench."},
	{"It might, a little.", 2, "Maybe. We do what we can."},
	{"It's none of my concern.", 0, "Nor mine, really."},
	{"It harms every fish in it.", -3, "Then say it to the fisherman, not to me."},
	{"It must be, the cold keeps it.", 3, "You've a quick head. Take bread."},
	{"I know nothing of it.", 0, "Few do. Nobody cares to ask."},
	{"It must be hell on the hands.", 3, "Aye. Look at these, split to the bone."},
	{"Of course. It's honest work.", 3, "That's what I tell him. Smell and all."},
	{"No. I'd choose my own.", 1, "Your own road, then. I'd choose the same."},
	{"Never. It's beneath me.", -4, "Beneath you! Then why sit at my table?"},
	{"A rush light, no more.", 3, "A guest after my own purse."},
	{"As many as I like.", -2, "As many as you like! Hear that, Damian?"},
	{"I sit in the dark.", 1, "Cheap, and sensible."},
	{"Whenever I'm offered it.", 3, "Then you'll have a cup. Tell me what you think."},
	{"Ale is my drink.", 0, "Ale, is it. Mead is what we pour at feasts."},
	{"Too sweet for me.", -2, "Sweet! It's honey and a lot of patience."},
	{"Many times. It passes.", 3, "I knew it! It does pass, doesn't it?"},
	{"Once, and I cried.", 2, "I didn't cry. Well, a little."},
	{"Bees are vermin.", -4, "They're not! They're the Lord's own workers."},
	{"Whatever the church can pay.", 1, "The church pays slow, but it pays."},
	{"More than they offer.", 3, "Aye. Hear that, Dobromila?"},
	{"Wax is only wax.", -3, "Only wax! It's bees' blood and a year's labour."},
	{"Yes, if you showed me how.", 3, "I will! I'll show you after supper."},
	{"No. I'd run.", 1, "Everyone says that at first."},
	{"Never, I'd be killed.", -1, "They don't kill. They just sting a lot."},
	{"Leave them plenty.", 3, "Good, you've a conscience. Have more cake."},
	{"Take what I need.", 0, "Fair enough, but leave the bees something."},
	{"Take it all. Bees can find more.", -4, "In winter? You'd kill them all."},
	{"They're the best I've had.", 4, "Then have the last one. I mean it."},
	{"They're fine, thank you.", 1, "Fine. Faint praise indeed."},
	{"Too sweet for my teeth.", -2, "Then give it to my daughter."},
	{"A kind heart.", 4, "Hear that, Mlada? A kind heart."},
	{"A man with land.", 1, "Land's useful. It won't warm a bed, though."},
	{"One who can cook.", 2, "A man who cooks! Mlada would marry him."},
	{"Strictly, yes.", 4, "That's piety. You'll do this table good."},
	{"I keep the great ones.", 2, "Fair enough, that's more than some do."},
	{"I forget most of them.", -2, "The priest remembers them for you."},
	{"Yes, it's a lovely sound.", 3, "It is. I'd take it over any song."},
	{"I only know the sting.", 0, "Learn the other sound. It's worth it."},
	{"It makes my skin crawl.", -2, "Then you'd best keep your distance."},
	{"For a fair wage, yes.", 3, "Ha. You'd freeze, but you'd be paid."},
	{"If the thief is armed, no.", 1, "Wise. A bee's worth less than a head."},
	{"It's not my affair.", -2, "No. But we remember who helped."},
	{"It smells sweeter and burns clean.", 3, "Yes! Exactly. Tallow stinks."},
	{"They're the same to me.", -1, "Not the same at all. Try it."},
	{"I'd never know the difference.", 0, "Then you've lived with tallow too long."},
	{"Boiled nettles and an old crust.", 4, "You know how it tastes, then. God keep you."},
	{"I've never been so hungry.", 0, "You've been lucky. Remember that."},
	{"I'd never eat chaff.", -3, "You've not been hungry enough yet."},
	{"Complain to the reeve.", 2, "The reeve takes it to the count. Round and round it goes."},
	{"Take it back at night.", 0, "Ha! They'd hang me for a goose."},
	{"Say nothing. Pay.", 1, "That's what we did. The goose is gone."},
	{"Honey and warm broth.", 3, "We've no honey. The Medars might spare some."},
	{"Herbs from the widow.", 3, "Aye. Blazej will go. Thank you."},
	{"Prayer alone will do it.", 1, "We pray. We still cough."},
	{"A bit. But eat, boy.", 3, "Thank you! I'll eat it slowly."},
	{"No, I'm full.", 1, "You're lucky, then. Mother says so."},
	{"Yes, and I'd take it myself.", -4, "That was ours. Mother, that was ours."},
	{"Many times. It's grim.", 3, "You've felt it, then. Sit, eat."},
	{"Never. I've worked for myself.", 0, "Must be nice. We've never had that."},
	{"A fair wage is a fair wage.", -2, "Fair? You've not met our yeoman."},
	{"For being alive.", 3, "I like that one. I'll say it too."},
	{"For a warm place to sleep.", 3, "Yes! Like us! Warm!"},
	{"For nothing. He gave me little.", -4, "Mother says that's a sin."},
	{"Call the watch.", 1, "The watch would laugh at us. Still, thanks."},
	{"Let him go. He's cold.", 3, "God bless you. We've done the same."},
	{"Beat him black and blue.", -3, "He might be a neighbour, that man."},
	{"Yes, it's a brave thing.", 4, "I will! I'll be so brave."},
	{"Only if I could sleep.", 0, "I'll sleep a little. Just a little."},
	{"It would be foolish.", -1, "Foolish? The hens need watching."},
	{"A warm stone at night.", 3, "A warm stone. Aye, that we can do."},
	{"Rest, if you can afford it.", 1, "We can't. But we'll try."},
	{"Stop working so hard.", -3, "Easy for you. Eat your bowl."},
	{"I owe a lot, too.", 3, "Then we're two of a kind, you and I."},
	{"Not a pfennig.", 0, "You're lucky. Or you're lying."},
	{"A man must pay or hang.", -2, "Aye. And many do both."},
	{"Once, at a distance.", 3, "Then you know the fear. Stay near a fire."},
	{"Never, thank God.", 1, "May it stay so. May it stay so."},
	{"I'd hunt them for sport.", -2, "Sport! They hunt us. Eat your pottage."},
	{"No, he knows his limits.", 3, "That's what I said! He's careful."},
	{"Yes, he's no use.", -1, "He's useful at the table. He eats well."},
	{"A good dog never runs.", -2, "Then you've never met a wolf."},
	{"Yes, I've done it before.", 4, "Then you're hired for Monday!"},
	{"I'd make a mess of it.", 1, "So did I, my first year."},
	{"Sheep scare me.", -1, "They scare me too, when it's thundering."},
	{"More than anyone pays.", 4, "Aye. You'd be a good shepherd."},
	{"A few pfennig.", 0, "A few! Too few, if you ask me."},
	{"I wouldn't know.", 0, "Nor do I. I take what's offered."},
	{"Yes, if it was needed.", 3, "Kind of you. I'd say the same."},
	{"Not for any money.", 0, "Nobody would, but he does it."},
	{"Sheep stink.", -3, "They do. So does the shepherd. Eat."},
	{"No, it's just a lamb.", 4, "That's what mother says!"},
	{"Maybe. Best be careful.", 0, "Then I'll watch it extra close."},
	{"Yes, it's cursed.", -4, "It is not! Don't say that."},
	{"Go to the reeve.", 2, "The reeve would find a reason."},
	{"Say nothing and wait.", 1, "That's what I did."},
	{"Take the count's ram too.", -3, "And hang for it. Not me."},
	{"A few, from my grandmother.", 3, "Then you could help us!"},
	{"Just the ones in the pot.", 1, "Those count too."},
	{"I know only weeds.", -1, "Weeds are herbs, sometimes."},
	{"Always. It works.", 3, "I'll tell Father! He'll be pleased."},
	{"I don't. I just sleep.", 1, "Lucky you."},
	{"I count coins instead.", 0, "Then you must be rich."},
	{"It's sharp and good.", 4, "Then have another slice."},
	{"It's all right.", 1, "All right is all we get."},
	{"I prefer cow's cheese.", -1, "Cow's cheese is for lords."},
	{"Yes, always.", 4, "God bless you. He remembers."},
	{"When I can spare it.", 1, "We can't always spare it."},
	{"The church takes enough.", -2, "Hush. Don't say that where it's heard."},
	{"Once. I ran.", 3, "Sensible. Plenty of men would lie about that."},
	{"Never, but I'd try.", 1, "Try on a day I'm not watching."},
	{"I'd kill it with one blow.", -2, "They all say that. Then the boar answers."},
	{"Yes, by law.", -1, "By law. And by the forester's boots."},
	{"No, to whoever lives in it.", 4, "Ha! You'd make a poacher yet."},
	{"I don't care about it.", 0, "Good. Keep it that way if the forester asks."},
	{"Something rare. A stag.", 2, "A stag! The count's own, I suppose."},
	{"Whatever feeds the family.", 3, "You know your duty, then."},
	{"Nothing. I don't hunt.", 0, "Then eat your cheese and be easy."},
	{"Never. It's a gift.", 3, "A friend would say that. Eat up."},
	{"I might wonder.", 0, "Wonder as quietly as you chew."},
	{"Yes, I would report it.", -5, "Then you've eaten your last meal here."},
	{"A winter on the road. I nearly froze.", 3, "Then you know what I mean. Sit and get warm."},
	{"I don't remember any.", 0, "Lucky guest."},
	{"I never feel cold.", -1, "Then sit on the draughty side."},
	{"Yes, and straight.", 4, "Then we've work for you."},
	{"A little. I'd practise.", 1, "Practise on a stump first."},
	{"I'd rather buy them.", 0, "So would I, if they flew straight."},
	{"No, but I've heard talk.", 2, "Talk is how it starts."},
	{"Yes. On the road to Talmberg.", 3, "I knew it. Thank you for the warning."},
	{"I'd welcome the company.", -3, "You've a strange taste in friends."},
	{"Yes, quite well.", 3, "A cook! Stay a week."},
	{"A little. Stew mostly.", 1, "Stew is all anyone needs."},
	{"Never. I eat what's put in front of me.", -1, "Aye. That's what I told her."},
	{"Share what I've got.", 3, "Then you're one of us."},
	{"Tighten my belt.", 1, "We've tightened ours."},
	{"Beg at the inn.", -1, "I'd rather hunt than beg."},
	{"I've heard a few good ones.", 2, "Tell one. We've time."},
	{"I've no stories.", 0, "Then listen to mine."},
	{"My stories would shame yours.", -2, "Go on, then. Say it."},
	{"Salt, and plenty.", 3, "We need plenty. I'll tell Robert."},
	{"Smoke and a cold cellar.", 2, "We've the cellar and the cold. It's the smoke we can't make."},
	{"I eat it fresh and fast.", 1, "A glutton's way, but it works."},
	{"Never. Not for any price.", 3, "Wise of you. We've no choice."},
	{"If I'd no choice, yes.", 3, "That's every miner's life."},
	{"I'd go for the iron.", -1, "Iron's heavy in a coffin."},
	{"Yes, I've seen one.", 3, "Have you now? Then sit. We've stories to swap."},
	{"No. They're stories.", 0, "So I thought. Then I went down."},
	{"Only the ones I made.", -1, "Make a better one, then."},
	{"A smith knows his ore.", 1, "Aye, well. He knows it too well."},
	{"A miner knows better.", 4, "There. Sense at last."},
	{"Neither. Both lie.", 0, "Ha! You've met both then."},
	{"Yes, if it was needed.", 3, "You're brave! Father says it's very dark down there."},
	{"Maybe. I don't like the dark.", 1, "I don't like it either. But I'm not scared."},
	{"Never.", 0, "It's easy. You just hold it still."},
	{"Often, if they've lived hard.", 4, "You've a good head. Eat."},
	{"Sometimes. Not always.", 1, "Aye. Look at me, I'm old and no wiser for it."},
	{"No. They're just slow.", -3, "Slow. I'll show you slow."},
	{"A few pfennig.", 2, "That's more than we have."},
	{"Almost anything.", 3, "Now that's an answer."},
	{"Nothing. I'd stay above.", 0, "We'd all stay above, if we could."},
	{"Wait and ask again.", 3, "Mother says I must wait."},
	{"Sneak down at night.", -3, "Mother would skin me!"},
	{"Go to the reeve.", 1, "The reeve won't care."},
	{"Hot broth and herbs.", 3, "We'll try it. Herbs we've few."},
	{"Rest and warm air.", 1, "Rest! Ha! Not a miner's word."},
	{"Strong drink.", 0, "Drink warms the belly. The lung stays damp."},
	{"For a fair wage, yes.", 3, "I'd say the same. It's honest work."},
	{"I'd do it twice for the pay.", 2, "You'd make a miner."},
	{"Never. It's a drowning.", 1, "It is. So is every day down there."},
	{"I'm too young to remember.", 0, "Then you're a lucky pup."},
	{"A fair share.", 1, "Fair! Ha! You've not met his steward."},
	{"Just as much, it's always the same.", 3, "True enough. We've paid it, and been poor, as long as I can remember."},
	{"A long time. It's good.", 4, "God bless you. The long ones are the best kind."},
	{"Not long yet.", 1, "Give it time. It grows on you."},
	{"I'm not one for love.", -2, "Then you'll miss a great deal."},
	{"Often. It's a duty.", 4, "That's kind of you. Folk have nearly forgotten us."},
	{"Sometimes, when I can.", 2, "Come again, then."},
	{"I keep to myself.", -2, "A hard way to live."},
	{"Yes. I know the grief.", 5, "You know it, then. Sit with us."},
	{"Not yet, thank God.", 1, "May He keep them all."},
	{"Everyone dies sooner or later. Get on with it.", -3, "That's a cold way to say it."},
	{"A few. They're good company.", 3, "They are. Mine talk to me."},
	{"No. Too much trouble.", 0, "They're no trouble. They're a joy."},
	{"I'd eat them.", -1, "At our age, so would we."},
	{"I often think so.", 3, "Aye. Even the hangings."},
	{"No. Every age is hard.", 3, "You've wisdom. Take some bread."},
	{"They were worse.", -1, "You're young. You'll see."},
	{"Whatever it takes.", 4, "Good for you. It's right to make the effort."},
	{"Only when it's near.", 1, "We'd say the same, were we young."},
	{"I rarely go.", -3, "The Lord keeps a record."},
	{"Gladly. Where are the baskets?", 5, "God bless you. Kunhuta, the baskets!"},
	{"If I had the time.", 1, "Time is all we've got."},
	{"I'm not a labourer.", -3, "No. No, you're not."},
	{"A parent, a child.", 3, "Yes. Those are the ones."},
	{"My own self.", 0, "Honest enough. A little vain, though."},
	{"Nobody. I'm alone.", 1, "There's always a seat here, then."},
	{"A warm blanket, a hot stone.", 3, "Either would be heaven."},
	{"Honey and herbs.", 3, "The widow says so too."},
	{"Nothing. You just endure it.", 1, "Aye, endure. We're good at that."},
	{"A good man, I'm told.", 3, "He is. He remembers the old."},
	{"I haven't met him.", 0, "You should. He'd like you."},
	{"I distrust priests.", -4, "Then you'll find no comfort here."},
	{"Fine as I've seen.", 3, "Ha! A man of taste. Eat, eat."},
	{"Gritty, to be honest.", -2, "Honest and rude. Vilma, he's the baker's cousin."},
	{"I couldn't tell.", 0, "Can't tell? You've no teeth to speak of."},
	{"Yes, I'm handy.", 4, "Then we've work for you after supper."},
	{"I could try.", 1, "Try, then. A bad patch is better than none."},
	{"That's a servant's job.", -3, "A servant's job! You're at my table."},
	{"No. Every trade is hated.", 3, "Wise. Father, listen to him."},
	{"A bit, yes.", 0, "At least you're honest."},
	{"Yes. He cheats.", -4, "Father, the guest says it plainly."},
	{"No. People need it now.", 3, "Hear that, father? Even the guest says so."},
	{"Yes, it's good business.", -1, "Father will like you for that."},
	{"It depends on the year.", 1, "A careful answer. You'd go far."},
	{"Only if the food is good.", 1, "It's not, but I'm used to it."},
	{"No. Pay in coin.", 4, "Thank you, guest. Hear that, master?"},
	{"Aye. He should be thankful.", -3, "I'd be thankful for a pfennig."},
	{"Wheat. It's softer.", 2, "A lord's taste. Have a slice."},
	{"Rye. It sticks to the ribs.", 3, "Good. We eat both here."},
	{"Whichever's free.", 0, "Practical. I can't fault that."},
	{"Yes. It's miserable.", 3, "You know the work. Good."},
	{"No, but I'd learn.", 1, "Come at dawn. I'll show you."},
	{"I'd never touch it.", -1, "Then you've never earned bread."},
	{"My best clothes.", 2, "That's what mother says."},
	{"Whatever I wore.", 3, "Same as me. I'll wear what I like."},
	{"Nothing fancy. I'd scare him.", 1, "Scare him off? I might try that."},
	{"Yes, you get used to it.", 3, "You do. I did."},
	{"No. The noise would drive me mad.", 0, "It nearly drove me off, some nights."},
	{"I'd sleep through anything.", 1, "You're lucky. I'd trade you."},
	{"Yes, God rewards giving.", 3, "There. You see, Arnost?"},
	{"Only if he's rich.", 1, "And he is. Aren't you, Arnost?"},
	{"No. Let them earn it.", -3, "Spoken like my husband."},
	{"No. Let him eat.", 3, "You're soft. But I like you."},
	{"Yes, it's your property.", 2, "At last, someone with sense."},
	{"I'd fish it myself.", -2, "Then you'll be run off with the rest."},
	{"If the neighbours agree, yes", 3, "Good answer. The neighbours agree, mostly. Now eat."},
	{"An honest land has no dead knights", 1, "Hah! You're quick. Dominik, I like this one."},
	{"Land is always taken from someone", -2, "True, and unkind. We've the paper. Eat your meat."},
	{"A hard worker has earned his bread", 4, "Bread, and ale, too. I'll cut another."},
	{"Half a loaf is fair for most", 1, "Half! And a quarter for the little one."},
	{"A hand who eats too much should be dismissed", -4, "Dismiss a hand in harvest? Eat quietly, guest."},
	{"Speak low, and give it salt", 4, "Salt! Cenek, did you hear that? I never thought of it."},
	{"Hitch it to a lighter plough", 2, "Not bad. Father, can we try the lighter plough?"},
	{"Beat it until it moves", -4, "Those oxen are worth more than you, guest. Mind your hand."},
	{"Nearly. Another year", 3, "That's ages. Mother, I'll grow quickly."},
	{"You look strong enough to me", 2, "Hear that, father? A guest says so."},
	{"No. You're far too small", -3, "I'm not small! I'm young. There's a difference."},
	{"I would. A neighbour's need comes first", 5, "That's well said. Anezka, fetch a basket. God sees it."},
	{"I'd sell them, not give them", 2, "Sell, then. A fair price for fair geese."},
	{"Geese are for your own table", -3, "They are. But a neighbour's table counts as well."},
	{"Yes. It's a duty, and a joy", 3, "That's right. A joyful tithe is a blessing."},
	{"Grudgingly. But I pay", 1, "That's honest. I pay grudgingly myself."},
	{"I don't pay. The church is rich enough", -5, "Then you'll not sit at my table twice."},
	{"I'll help. Give me a sickle", 5, "Take the long one. Cenek, show our guest the field."},
	{"Half a day, if it stays mild", 2, "Half a day will do. We'll take it."},
	{"I'm no labourer", -3, "No. But the bread you eat is made by one."},
	{"See if he stays when there's nothing left", 4, "That's the best I've heard. I'll tell him there's no dowry."},
	{"Ask him straight", 2, "I'd die of shame. But I'll try."},
	{"She can't know. Not ever", -2, "Then I'll marry the first who asks. It's all the same."},
	{"Yes, for my family", 3, "Spoken like a Sedlak. Sit. We'll tell you of the bull."},
	{"No. I'd have hidden in the cellar", 2, "Sensible. I hid too, and look at me. Still here."},
	{"War is a good way to get rich", -4, "A good way to get dead. I've buried the rich ones."},
	{"The abbey keeps several", 3, "The abbey. They lend, but they remember."},
	{"I'll ask along the road", 4, "Do. I'll pay in grain, or in a day's work."},
	{"Eat the ox", -3, "Eat him? My grandfather would rise from his grave."},
	{"Yes. I'll find five", 5, "God keep you. Ask the Sedlak farm. They've plenty."},
	{"I've none, but I'll look", 2, "Do look. If you find one, we'll find a loaf."},
	{"Geese are a fool's business", -3, "The abbey eats them. That's no fool's business."},
	{"Happy to. It's a good deed", 5, "Bless you for it. The garden's by the north wall."},
	{"An hour. No more", 1, "An hour's an hour. Take a basket."},
	{"Weeding's beneath me", -3, "Nobody's too good for weeding. The abbot himself kneels in that garden."},
	{"Yes. I'll read one gladly", 5, "Then read. Slowly. We'll listen, hands folded."},
	{"A little. Not Latin", 2, "Then tell us what the pictures mean."},
	{"No, but I know the prayers", 3, "That's what we know too. We say them by heart."},
	{"Always. I'm devout", 3, "Good. We keep them too. The pike is a gift."},
	{"When I remember", 1, "Try to. It's a small thing."},
	{"No. Meat's meat", -4, "Then you'll sit with a bare plate on Friday."},
	{"It is, if you're careful", 3, "Careful's our way. Thank you."},
	{"No. It's blocked at the bridge", 2, "Then we've another week. God sent us rest."},
	{"I never noticed. I wasn't looking", 0, "Then you walk with your eyes shut. Eat your bread."},
	{"Yes. For the geese and the roof", 4, "Both. You're a good soul. Amen."},
	{"I'll pray silently", 1, "Silent will do. God hears."},
	{"I pray for myself first", -3, "Then you'll pray alone. Eat, and be quiet."},
	{"A kind man, and quiet", 3, "That's the brothers all over. God bless them."},
	{"They're all rich and fat", -3, "You've not seen them fast. Hush now."},
	{"I've never met one", 1, "Then you've a surprise. They're men like us, with beards."},
	{"Show me the rows and I'll plant", 4, "Here. Press them in, a finger deep."},
	{"If you feed me well", 1, "We'll feed you. There's not much."},
	{"Peas aren't my work", -2, "Then eat, and leave us to plant."},
	{"Gladly. I'll bring an armful", 5, "God bless you. That wood's a gift to us."},
	{"Tomorrow, when it's light", 2, "Tomorrow's fine. We'll pile on rags tonight."},
	{"Cut your own", -3, "We would. But the axe is cracked and the wood's wet."},
	{"Kinder than most lords", 3, "That's what we say. Kinder, and quieter."},
	{"Fair, if you pay on time", 2, "Time's the trouble. It runs faster than we do."},
	{"No. They squeeze the poor", -4, "Hush! Don't say it in the house. The walls listen."},
	{"Always. It keeps sickness off", 4, "Hear that, Kasimir? Sensible folk wash. Pass the bowl."},
	{"Now and then", 1, "Now and then. Better than never, I suppose."},
	{"Washing is for monks", -3, "You sound like my husband. God help us both."},
	{"The surgeon for bones, the herb woman for fevers", 4, "Hah! A fair answer. Kasimir, take note."},
	{"A surgeon. He has a diploma", 2, "A diploma, ha. All he has is a razor and a loud voice."},
	{"The herb woman. The surgeon is a butcher", -4, "Butcher! You'll go lame before you've a single complaint."},
	{"No. Give him honey and rest", 2, "Honey! That's what the widow says. I'd not admit it, mind."},
	{"If it's the duke's order, yes", 1, "The duke's order is the law. I do what's told."},
	{"A boy with a cough needs no knife", -1, "A razor, not a knife. There's a difference."},
	{"Gladly. I've a high pain threshold", 3, "A brave fool. Sit. I'll bring the splints."},
	{"Give me ale first", 2, "Ale first. Kordula, a jug."},
	{"No. I'd run", -1, "Wise of you. I'm out a patient, though."},
	{"Yes. Tell me which", 5, "Comfrey, plantain, and yarrow if you see it. God bless you."},
	{"If I pass the woods", 1, "Pass the woods, then. They're by the stream."},
	{"I'm not a gardener", -2, "Nor am I. The sick still need the herbs."},
	{"Yes, and I ignore them", 2, "Just like my husband, then."},
	{"Yes, and I listen", 3, "Rare, that. Kasimir, take a lesson."},
	{"No. They'd never dare", -2, "Then they're braver than I thought, to stay with you."},
	{"Bad water. Boil it", 3, "The widow says the same. I'll not be telling her that."},
	{"Bad air from the marsh", 2, "Aye, the air. The old books say so."},
	{"God's wrath for our sins", 1, "Perhaps. But the cure's still herbs and rest."},
	{"No, thank you. I'm well", 2, "Healthy, then. Sit and eat."},
	{"Yes. It's custom", 1, "Custom, aye. A small bowl, then."},
	{"It's barbaric", -3, "Barbaric! It's medicine. Learn the difference."},
	{"Once. It was dreadful", 3, "Then you understand. I've a gentle hand. Kasimir hasn't."},
	{"No. I have all of mine", 2, "All of them? A wonder. Show us, I'm curious."},
	{"A real man needs no help for a tooth", -3, "Real men weep in my chair. Mind your boasting."},
	{"Yes. Tell me what to avoid", 3, "Less meat, less ale, and more walking. You'll live."},
	{"I'd listen, then do as I please", 0, "That's what he does. Bless him."},
	{"Never. A man eats what he likes", -3, "Then you'll visit me soon, with a swollen foot."},
	{"Gladly. Show me the anvil", 5, "A willing hand! Sit here. Mind the sparks."},
	{"An hour, perhaps", 1, "An hour is a hundred rivets. I'll take it."},
	{"War is no business of mine", -2, "It's the duke's business, and it puts bread on my table."},
	{"Yes. A bad hinge once", 3, "Everyone starts with a hinge. Mine never fell, though."},
	{"No. All my goods are sound", 1, "Then you've good luck, or you buy from me."},
	{"Smiths are all the same", -3, "All the same? Come to the forge and I'll show you the difference."},
	{"Yes. Three baskets", 5, "Good. Bring them to the back door."},
	{"It's heavy. For a good price", 1, "A fair price, then. I'll pay it."},
	{"It's dirty work", -2, "It is. That's why we pay."},
	{"Put a hot pie on the anvil", 3, "A pie on the anvil. Now that's an idea I like."},
	{"Take the lamp away", 2, "Take the lamp and he'd work in the dark, the fool."},
	{"You can't. A man is his work", -1, "That's what they say. It's also why we eat cold."},
	{"A copper coin from my grandfather", 3, "Better than a rivet, a coin. I'll look for one."},
	{"No. I make my own luck", 2, "Brave words. A rivet never hurt anyone, though."},
	{"Charms are nonsense", -2, "We don't say that near the forge. The iron listens."},
	{"The weavers in the village sell offcuts", 4, "Offcuts, that's a good thought. I'll walk over tomorrow."},
	{"I'll look about for him", 4, "Do. We'd pay a fair coin."},
	{"A man should earn his own coat", -2, "He earns it daily. At a bench, in the heat."},
	{"Once, a fingertip. It healed", 3, "A fingertip! Mine are all blisters. A veteran's hands."},
	{"No. I stay clear of fire", 1, "Sensible. We've a seat by the window."},
	{"A man without scars is no man", -2, "Is that so? I'd rather have eyebrows."},
	{"Yes. How much do you need?", 5, "Three bars. Bring them, and I'll feed you for a week."},
	{"I'll ask the smiths", 2, "Ask. They'll want to be paid first."},
	{"Iron is dear. Make it yourself", -2, "I'm an armourer, not a miner. Nor a fool."},
	{"No. I'd smile and agree", 2, "Wise. Whoever agrees keeps his head."},
	{"Yes, politely, if I were sure", 3, "Politely and sure of it. Both are rare."},
	{"Yes. Loudly", -4, "Loudly? He'd have you in the stocks by noon."},
	{"Yes. His family is his true work", 4, "Hear that, Bernard? True work. Put down the hammer."},
	{"No. The work feeds the family", 1, "It feeds them, I'll grant you. It doesn't sit at the table."},
	{"Craft before everything", -2, "Craft doesn't warm a bed."},
	{"Yes, a little", 3, "A little is a great deal. Sit and eat, and we'll talk of books."},
	{"No, but I can count", 2, "Counting is half of it. Suspicion is the other half."},
	{"Reading is a waste of time", -4, "A waste! A man who cannot read is a fish in a net. Pass the salt, Bertold."},
	{"Gladly. I know where oaks grow", 4, "Oak galls, the small round ones. Bring a handful."},
	{"I'll look about", 1, "Pick with care. A poor gall gives a pale ink."},
	{"Ink is just soot and water", -3, "Soot and water! That insults the art of three centuries."},
	{"Rarely. I'm honoured", 3, "Honoured is the right word. I'm glad of the company."},
	{"Never. I dine with farmers", 1, "Farmers are honest men. Better than some scribes."},
	{"Learned men are boring", -3, "Boring! Let me tell you the duke's secrets. You'll beg to hear more."},
	{"Yes. I'll guard it with my life", 5, "A life is more than I need. Your word will do. Here it is."},
	{"If it's paid", 1, "It's paid. Six pfennig, a fair price for a scribe's errand."},
	{"Letters are best opened and read", -5, "Then you shall not carry mine. Good evening to that idea."},
	{"Yes. I'll ask the brothers", 4, "They sell at an honest price. Three sheets will do."},
	{"I'd have to see the coin", 2, "You'll have the coin. Eighteen pfennig for three sheets."},
	{"A calf's skin is for boots", -3, "Boots! A calf can end as a boot or a book. The book lasts longer."},
	{"No. It ruins the eyes", 3, "Hear that, master? Your eyes, master."},
	{"A man reads in whatever light he has", 2, "That's what master says, but I've never seen him squint."},
	{"Light is for the rich", 0, "Light's for everyone, as God made the sun. Eat, guest."},
	{"By the seal and the hand", 4, "Exactly! You've the makings of a clerk."},
	{"By the smell of fresh ink", 2, "Clever. A good forger ages his ink, though."},
	{"I wouldn't. I'd believe it", -2, "That, friend, is why we have scribes."},
	{"The roads are sound, but muddy", 3, "Muddy, ah. Late couriers, then, and an irritated duke."},
	{"A traveller spoke of unrest in the south", 2, "Unrest in the south? Always unrest. Write it down, Bertold."},
	{"News is for gossips", -2, "Gossips and scribes are cousins. We just write ours down."},
	{"Yes. Loyalty is rare", 4, "Rare, yes. I've raised Bertold's wage twice. Don't tell him."},
	{"A servant is paid what he's worth", 0, "Exactly so. That's why I've been generous."},
	{"Servants should be grateful for a roof", -4, "Grateful! Bertold, are you grateful? Don't answer."},
	{"It does. But work must go on", 3, "True. A scribe sweats and goes on writing."},
	{"Work in the early morning", 2, "Wise. I rise at four, when the pen is happiest."},
	{"Heat is good for the blood", -1, "Is it? Not for ink, I assure you."},
	{"Gladly. A great honour", 3, "An honour, and a danger. Boars don't respect rank."},
	{"I'd rather watch from a hill", 2, "Fair enough. The clever ones watch from the hill."},
	{"Hunting's for the idle rich", -4, "Idle! I rise at three. You'll not say that twice at my table."},
	{"No. But I'll watch for snares", 4, "Do. A snare is easy to see, once you know."},
	{"I saw a man with a sack near the ford", 3, "A sack, near the ford. Tell me about him later. I'll send Lambert."},
	{"A hungry man takes what he can", -3, "A hungry man asks for work. Taking what isn't yours makes him a thief."},
	{"Better, sometimes", 4, "Hear that, father? Better!"},
	{"Equal, with practice", 3, "Practice! I can do that. I'll practice every morning."},
	{"No. A woman belongs at home", -4, "Then you'll eat alone at home, guest."},
	{"Keep her by the fire", 4, "By the fire! Father, did you hear? We'll do that."},
	{"Put her out of her pain", -1, "That's a hard answer. We won't do it yet."},
	{"Feed her scraps and let her sleep", 3, "Yes, that's what I'll do. Scraps, and she can sleep all she likes."},
	{"Yes. Two cuts", 4, "Two cuts, good! The duke's own are better, but we'd not tell."},
	{"I might catch a hare instead", 2, "A hare! Not the duke's, I hope."},
	{"Feed them bread", -2, "Bread! They'd hunt for crumbs and go hungry."},
	{"Very. I'd climb a tree", 3, "A wise answer. Even my husband would climb a tree."},
	{"Not if I've a spear", 2, "A spear! Gotthard has several. He'll lend you one, and not return."},
	{"Boars are nothing to a brave man", -3, "That's what Heinrich said. Heinrich walks with a limp now."},
	{"Yes. Distant, but clear", 3, "Distant is good. I'll lay traps tomorrow."},
	{"No. The night was silent", 1, "Silent is worse. When they're quiet, they're hunting."},
	{"Wolves don't frighten me", -2, "Then you're a fool, or a wolf."},
	{"Yes. I'll show you a thing or two", 3, "Good. Adela will watch. She'll laugh if you miss."},
	{"A little. I'd rather watch", 2, "Then watch. Learn the draw."},
	{"I never touch a bow", 0, "Then you're safe, and so is the barn."},
	{"Yes. My lips are sealed", 3, "Good. The duke's gamekeeper would hang the lot of us."},
	{"I'll say nothing, for a slice", 1, "A slice, then. Hush, and eat."},
	{"I'd have to tell the reeve", -5, "Then you'll not have seen the pot, nor eaten of it."},
	{"Yes. I'll ask the bowyer", 4, "Kolar's boy, Kristof, makes a fair shaft. Say I sent you."},
	{"I'll try, for a fair price", 2, "Ten pfennig for ten. That's fair."},
	{"Teach your son to fletch", -3, "I try. He's fletching with the wrong feathers."},
	{"Yes. I'm glad of the fire", 3, "Sit by the fire, it's free. The ale you pay for."},
	{"No. I came before it fell", 1, "Lucky. The pass closes every winter, like a bad tooth."},
	{"The snow is God's will", 2, "Aye. It's also God's will we eat. Pass the loaf."},
	{"Stand at the shoulder, not behind", 4, "The shoulder! Father, did you hear? Not behind."},
	{"Give her an apple", 3, "An apple! She'd kick and eat it."},
	{"Hit her with a stick", -4, "No! She'd kick harder. I don't want to be kicked harder."},
	{"Yes. A big one, they say", 2, "I told you, Walter. A big one."},
	{"No. Is it near?", 1, "Not near. But the roads will be full of soldiers soon."},
	{"War is always far away", 0, "Until it's at the door. I remember. I was a girl."},
	{"A guest is a gift, I think", 3, "Spoken like someone raised right."},
	{"It must be lonely", 2, "Lonely and busy both, on the same day."},
	{"Why live so high?", -1, "Because the view is free. The rest, we pay for."},
	{"Yes. Six bundles", 5, "Six. Good. Fricek, show our guest the shed."},
	{"Two, if my back allows", 2, "Two's two. We'll take it."},
	{"It's not my job", -2, "Nor mine, but the fire doesn't care."},
	{"Yes. I'll carry them", 4, "Good. The Sedlak farm sells at a fair price."},
	{"I'd pay half, if you pay half", 1, "Half! You drive a bargain. I like that."},
	{"Horses can eat hay", -2, "Horses eat what they must. But a hungry horse is a kicker."},
	{"Yes. A penny every week", 4, "A penny! I'd be rich! Father, look!"},
	{"He deserves a bowl, no more", -1, "A bowl... I eat it already."},
	{"He deserves a good horse one day", 3, "A horse! Oh, I'd name her Silver."},
	{"A plain traveller. I pay in coin", 3, "Coin! The best pilgrim of all."},
	{"A pilgrim. I've little", 1, "Then a blessing and a bowl, but no ale."},
	{"I'm neither. I'm lost", 2, "Lost is common. You wouldn't be the first on this pass."},
	{"The map was of the wrong mountain", 4, "Hah! That's it! You've heard it before, you rogue."},
	{"No. Tell me", 2, "The map was of the wrong mountain. A very old joke."},
	{"Jokes about monks are sinful", -3, "Sinful or not, it makes the ale go down."},
	{"No. But I saw fresh tracks", 3, "Fresh tracks means they're real. I'll bar the stable."},
	{"None, but I felt watched", 2, "Then they were watching you. Sit nearer the fire."},
	{"I met them. They robbed me", 1, "Robbed! Sit down and eat, and have a free ale on me."}
};

enum E_FAMILY_CONVO_DEF
{
	E_FAMILY_CONVO_DEF_FAMILY,
	E_FAMILY_CONVO_DEF_SUBJECT[32],
	E_FAMILY_CONVO_DEF_SEASON,
	E_FAMILY_CONVO_DEF_MEAL,
	E_FAMILY_CONVO_DEF_FIRST_LINE,
	E_FAMILY_CONVO_DEF_LINES,
	E_FAMILY_CONVO_DEF_ASKER,
	E_FAMILY_CONVO_DEF_QUESTION[128],
	E_FAMILY_CONVO_DEF_FIRST_ANSWER,
}

new const g_FamilyConvoDefs[422][E_FAMILY_CONVO_DEF] = {
	{0, "the thin rye", 2, -1, 0, 3, 0, "You've walked the fields. Is the rye as bad as I say?", 66},
	{0, "Matej and the cat", -1, 0, 3, 4, 2, "Would you say a boy should be beaten for a thrown stone?", 69},
	{0, "the grandmother's cows", -1, 0, 7, 4, 1, "Tell me, young one, do you keep a cow where you come from?", 72},
	{0, "seed sacks", 1, -1, 11, 4, 0, "Spring's short. Could you spare an hour on the strip?", 75},
	{0, "the wolf at the wood", 3, 1, 15, 4, 1, "Have you seen wolves on the road yourself, traveller?", 78},
	{0, "the neighbour's ox", 1, -1, 19, 4, 0, "Is it right to ask a neighbour for his ox and pay with labour?", 81},
	{0, "the hen that won't lay", -1, 0, 23, 4, 4, "Will you tell Mother the hen should stay? Please?", 84},
	{0, "the clerk counts sheaves", 3, 0, 27, 4, 0, "Have you ever hidden a sheaf from a tax man?", 87},
	{0, "candle ends", -1, 1, 31, 4, 1, "Will you say the evening prayer with us, guest?", 90},
	{0, "the cold hearth", 0, 1, 35, 4, 0, "Our wood won't last the winter. Could you help us?", 93},
	{0, "the harvest goose", 3, -1, 39, 4, 5, "Would you eat a goose that has a name?", 96},
	{0, "old Ludmila's husband", 0, 1, 43, 4, 1, "Do you remember someone you've lost, child?", 99},
	{1, "damp wool", 3, -1, 47, 4, 6, "You've seen wool. Can a fire dry it without ruining it?", 102},
	{1, "lumpy yarn", -1, 0, 51, 4, 8, "Is my yarn really so bad? Look at it, please.", 105},
	{1, "the blue cloth", 2, -1, 55, 4, 6, "Would you carry a message to the dyer sisters for me?", 108},
	{1, "bolt and cow", -1, 0, 59, 4, 6, "Which would you rather own, a cow or a bolt of good cloth?", 111},
	{1, "staring at mass", -1, 0, 63, 4, 8, "Should I smile at him once, just to see?", 114},
	{1, "aching hands", -1, 1, 67, 4, 7, "Do you know any cure for aching hands, traveller?", 117},
	{1, "sheep shearing", 1, 0, 71, 4, 8, "Would you help me pick burrs from a fleece? I'd pay you in bread.", 120},
	{1, "the loom's creak", 0, 1, 75, 4, 6, "Could you find a little fat for my loom, if I pay you?", 123},
