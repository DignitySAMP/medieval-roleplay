	{40, "Fricek", 7, 0, 0, 181, 104, {-2.620, 8.700, 0.760, 90.0}, "stable boy"}
};

enum E_FAMILY_TOPIC_DEF
{
	E_FAMILY_TOPIC_DEF_FAMILY,
	E_FAMILY_TOPIC_DEF_MEMBER,
	E_FAMILY_TOPIC_DEF_TEXT[128],
}

new const g_FamilyTopicDefs[FAMILY_SEED_TOPICS][E_FAMILY_TOPIC_DEF] = {
	{0, 0, "The rye on the low strip is coming up thin. It had too much rain."},
	{0, 2, "Eat, all of you. There's no more after this pot."},
	{0, 1, "In my day we had three cows and nobody went hungry in {season}."},
	{0, 5, "I didn't! It was Bara."},
	{0, 1, "Say your prayers before you sleep. The nights are long in {season}."},
	{1, 6, "The merchant wants the blue cloth by the end of {season}. Blue! Where do I get blue?"},
	{2, 9, "Then where? The rolls are due before {season} ends."},
	{3, 13, "Up before Prime again tomorrow. The oven won't light itself."},
	{4, 16, "The mason wants new scaffold poles before {season} is out."},
	{4, 16, "Then we'll buy it from the woodcutter. He'll charge us double."},
	{5, 19, "Two travellers left without paying last night. Two!"},
	{6, 23, "Then we'll have coin for {season} for once."},
	{7, 26, "Give her warm mash. She did this last {season} too."},
	{8, 29, "The bees swarmed again. Third time this {season}."},
	{9, 31, "The castle wall has a crack you could put your fist in."},
	{10, 34, "Big boar tracks by the south clearing. Keep out of there at dusk."},
	{11, 36, "The reeve's clerk wants a new black coat, lined, by Sunday."},
	{12, 40, "Father, let me take the cart to the fair this {season}."},
	{13, 43, "Your cough's worse this {season}. I'll fetch the herb widow."},
	{14, 44, "The innkeeper says the ale's sour. The innkeeper says a lot of things."},
	{15, 48, "Charcoal's short this {season}. The burner sleeps more than he burns."},
	{16, 51, "Five mouths, a goat and one strip of turnips. Lord help us."},
	{16, 52, "The Lord helps those who weed their turnips, Prokop."},
	{16, 51, "Then the goat's eaten better than we have this {season}."},
	{16, 52, "The chandler's wife gave us two candles. Say a prayer for her."},
	{16, 51, "The church roof leaks right over our bench. Even God doesn't want us dry."},
	{16, 52, "Hush. Eat what there is."},
	{17, 55, "The woad came out green again. Green! Nobody wants green."},
	{17, 56, "The crofter's wife wants green. For the baby's blanket."},
	{17, 55, "Then the crofter's wife will pay for green."},
	{17, 56, "A weaver from Talmberg came asking for blue. Pavel, the one with the daughter."},
	{17, 55, "Pavel can come and ask himself. I won't send blue for nothing."},
	{17, 56, "We should marry, Vendula. Both of us. Before {season} ends."},
	{18, 57, "Every cart in the village needs a new wheel and nobody can pay for one."},
	{18, 59, "The hunter wants a yew bow. Real yew. Where do I find yew this side of the river?"},
	{18, 57, "The steam trough's cracked. We'll lose a week."},
	{18, 58, "Kristof, the dyer sister asked after you again."},
	{19, 60, "Every loaf in this village passes through my oven. Every loaf. And they still bargain."},
	{19, 60, "Then he'll pay before I bake them. I learned that from your father."},
	{20, 62, "Another child coming in the crofter's house. That's the sixth."},
	{20, 62, "Feverfew for the fever, comfrey for the bones, and prayer for the rest."},
	{20, 62, "The barber-surgeon in the lowland bleeds everyone. Bleeds them dry."},
	{20, 62, "Eat, guest. It's a poor table, a healer's, but nobody leaves it hungry."},
	{20, 62, "My husband built this house. Thirty years he's been in the churchyard."},
	{20, 62, "If you see yarrow by the road in {season}, bring it to me. It stops bleeding."},
	{21, 63, "The church wants two hundred candles for the feast. Two hundred!"},
	{21, 63, "Prayers and the odd coin. Better than the crofter, who pays in turnips."},
	{21, 66, "The tallow stinks, father. The whole house stinks of it."},
	{21, 63, "He can ask me when he can read the price of a candle."},
	{22, 67, "The Hare's the best alehouse this side of the river. Ask anyone."},
	{22, 68, "It's the only alehouse this side of the river, Otakar."},
	{22, 68, "The bowyer drank on credit again. That's three weeks."},
	{22, 67, "He'll pay. Anyone who makes bows gets paid in the end."},
	{22, 68, "The kegs are low. Talk to the brewer in Talmberg."},
	{22, 67, "Drink up, guest. The first one's on the house. The second one isn't."},
	{23, 69, "The eels are running early this {season}. Set the traps tonight."},
	{23, 70, "Fish again. Every day fish. I'd kill for a sausage."},
	{23, 69, "On fast days the whole county eats like us and pays for it."},
	{23, 71, "I caught a trout with my hands today. A big one!"},
	{23, 72, "It was small."},
	{23, 69, "Somebody's been taking from my traps upstream. If I catch him..."},
	{23, 70, "You'll do nothing. You'll tell the guards."},
	{23, 69, "The guards eat my fish too. For free."},
	{24, 73, "Every roof in the hamlet leaks and every one of them wants me first."},
	{24, 74, "Then do ours first. It's dripping on the bed."},
	{24, 73, "The thatcher's own roof leaks worst of all. Like the cobbler's barefoot children."},
	{24, 74, "The reed bed by the river is flooded."},
	{24, 73, "Then it's straw this year, and straw rots."},
	{24, 74, "Say grace, Havel. Before the drip finds the pot."},
	{25, 75, "Three pigs to slaughter before {season} ends and the salt's gone up again."},
	{25, 76, "Then we smoke instead of salting."},
	{25, 79, "The fisherman wants sausage for eel. I told him we don't trade for eel."},
	{25, 75, "We trade for anything that keeps."},
	{25, 77, "A boar came through the herdsman's pens. He's asking if we'll butcher it."},
	{25, 75, "If he catches it, we'll butcher it."},
	{25, 78, "The blood pudding's not set yet, mother."},
	{25, 76, "Then we'll eat it runny. Eat."},
	{26, 80, "The neighbours say we stink. Let them wear their shoes without leather, then."},
	{26, 81, "The priest won't have us at the front at mass. It's the smell, he says."},
	{26, 80, "Then we'll stand at the back and pray louder."},
	{26, 81, "The bark tubs are nearly empty."},
	{26, 80, "Then tomorrow you're in the woods stripping oak."},
	{26, 80, "Your mother never minded the smell. Rest her soul."},
	{27, 84, "The mead's ready. Best batch in three years."},
	{27, 82, "You said that about the last batch."},
	{27, 84, "And it was true then too."},
	{27, 83, "A bee stung me on the eyelid. Look!"},
	{27, 82, "You were too close to the skep again."},
	{27, 84, "The chandler's cousin wants our wax, all of it, for the church."},
	{27, 82, "Then the church can come to us for honey too."},
	{27, 84, "Have a honey cake, guest. Dobromila swears there's nothing sweeter in this hamlet."},
	{28, 85, "Two days I worked for the yeoman. He paid in rye that's half chaff."},
	{28, 86, "It's food. Be thankful."},
	{28, 87, "I'm still hungry."},
	{28, 86, "We're all still hungry, Kaspar."},
	{28, 85, "The count's men took the goose for the tax. The goose!"},
	{28, 86, "Grandmother's cough is bad again. The little ones too."},
	{28, 85, "You've picked a poor table to be a guest at. It's a warm one, though."},
	{29, 88, "Lost two lambs to the wolves on the high pasture."},
	{29, 89, "Take the dog with you next time."},
	{29, 88, "The dog's afraid of the wolves."},
	{29, 90, "I'll fight them with my sling!"},
	{29, 89, "You'll do no such thing."},
	{29, 91, "The weaver in Talmberg wants our fleeces. All of them."},
	{29, 88, "Then the Talmberg weaver can pay what they're worth."},
	{30, 92, "Boar tracks by the stream, a big tusker's. I'll have him before {season} ends."},
	{30, 93, "And the forester will have you, if he catches you in the count's wood."},
	{30, 92, "The count's wood is any wood the forester can see."},
	{30, 93, "The pelt from the fox fetched less than we thought."},
	{30, 93, "Eat, guest. It's venison, and we didn't buy it, so don't ask."},
	{31, 94, "The new seam's good iron, but the shaft groans at night."},
	{31, 95, "Then don't go down at night."},
	{31, 98, "I went down fifty years and look at me. Coughing my lungs out."},
	{31, 96, "Father lets me hold the lamp now."},
	{31, 95, "And you'll come up every evening, or I'll go down after you."},
	{31, 97, "Grandfather, tell the story about the ghost in the old shaft."},
	{32, 99, "It feels like a hundred."},
	{32, 100, "The hens are laying again. Two eggs this morning."},
	{32, 99, "The herdsman's wife brought milk. Good woman."},
	{32, 100, "Our boys are in the churchyard, guest. You'll forgive us if we talk too much. Nobody visits."},
	{33, 101, "The baker says my flour's gritty. The baker says that every year."},
	{33, 102, "It is gritty, Arnost. The stones need dressing."},
	{33, 105, "The sail's torn again. The wind took a corner off it."},
	{33, 101, "Then mend it before the farmers bring the harvest."},
	{33, 104, "The brewer says you're holding barley back for a better price."},
	{33, 101, "The brewer can buy his barley elsewhere, then."},
	{33, 103, "Everyone hates the miller, father. Why do you make it worse?"},
	{33, 101, "Because everyone needs the miller, girl. That's why they hate him."},
	{34, 106, "Free land, free men. My grandfather paid silver for this farm. No count takes it."},
	{34, 107, "Your grandfather paid in silver he took from a dead knight. Don't forget that."},
	{35, 114, "Brother Hugh says the herb garden needs weeding before the frost."},
	{35, 115, "Everyone wants something from us. We can't read a word of the psalter on the wall."},
	{35, 115, "Bless this food, and the abbey that feeds us."},
	{36, 116, "Bled three men today, set a leg and pulled a tooth. A good day."},
	{36, 117, "Wash your hands before you touch the bread, Kasimir."},
	{36, 116, "Washing's for monks. Blood dries."},
	{36, 117, "The herb widow in the village says you bleed people dry."},
	{37, 118, "Then we'll make rivets, Fridrich. All night if we have to."},
	{37, 119, "You said that last {season} and slept at the bench."},
	{38, 122, "Anyone who reads is hard to fool. Anyone who can't gets fooled every day."},
	{38, 122, "Sit, guest. Eat. You're the first company at this table since {season} began."},
	{39, 124, "The duke hunts Thursday. I want every hound in the kennel fit."},
	{39, 124, "Then she stays home and we pray for no boar."},
	{40, 129, "A merchant came through with news of a war in the south."},
	{40, 129, "Warm yourself by the fire, traveller. The pass is cold this {season}."}
};

enum E_FAMILY_ERRAND_DEF
{
	E_FAMILY_ERRAND_DEF_FAMILY,
	E_FAMILY_ERRAND_DEF_KIND,
