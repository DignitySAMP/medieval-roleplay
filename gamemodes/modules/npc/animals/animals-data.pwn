stock Animals_NavBody(species)
{
	switch (species)
	{
		case ANIMAL_COW, ANIMAL_RED_DEER, ANIMAL_ROE_DEER, ANIMAL_BOAR, ANIMAL_BEAR:
		{
			return PED_BODY_DEER;
		}
	}

	return PED_BODY_SHEEP;
}

